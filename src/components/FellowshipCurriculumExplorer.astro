---
// src/components/FellowshipCurriculumExplorer.astro
---

<div class="w-full max-w-5xl mx-auto rounded-3xl border border-stone-200 dark:border-slate-800 bg-white dark:bg-[#0b192c] p-6 sm:p-10 shadow-lg transition-colors duration-200">
  <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-stone-200 dark:border-slate-800 pb-6 mb-8 gap-4">
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-sap-terracotta dark:text-amber-400">
        Academic & Experiential Architecture
      </span>
      <h3 class="font-serif text-2xl sm:text-3xl font-bold text-sap-navy dark:text-white mt-1">
        1-Year Fellowship Journey (12 Months)
      </h3>
    </div>
    <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">
      4 Academic Terms • 6–8 hrs/week • 4 Residential & Field Circuits
    </div>
  </div>

  <!-- Term Filter Jumpers -->
  <div class="mb-4 flex flex-wrap items-center gap-2 border-b border-stone-100 dark:border-slate-800/80 pb-3">
    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mr-1">Terms:</span>
    <button type="button" data-term-jump="0" class="term-btn rounded-lg px-3 py-1.5 text-xs font-semibold uppercase tracking-wider transition bg-sap-navy dark:bg-amber-500 text-white dark:text-slate-950 shadow-sm">
      Term 1: Foundations (M1–M3)
    </button>
    <button type="button" data-term-jump="3" class="term-btn rounded-lg px-3 py-1.5 text-xs font-semibold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Term 2: Grassroots & Finance (M4–M6)
    </button>
    <button type="button" data-term-jump="6" class="term-btn rounded-lg px-3 py-1.5 text-xs font-semibold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Term 3: Policy Lab & AI (M7–M9)
    </button>
    <button type="button" data-term-jump="9" class="term-btn rounded-lg px-3 py-1.5 text-xs font-semibold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Term 4: Campaigns & Capstone (M10–M12)
    </button>
  </div>

  <!-- 12-Month Navigation Pills -->
  <div class="flex items-center gap-2 overflow-x-auto pb-4 scrollbar-none" id="timeline-tabs">
    <button type="button" data-month="0" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-sap-navy dark:bg-amber-500 text-white dark:text-slate-950 shadow">
      Month 01
    </button>
    <button type="button" data-month="1" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 02
    </button>
    <button type="button" data-month="2" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 03
    </button>
    <button type="button" data-month="3" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 04
    </button>
    <button type="button" data-month="4" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 05
    </button>
    <button type="button" data-month="5" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 06
    </button>
    <button type="button" data-month="6" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 07
    </button>
    <button type="button" data-month="7" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 08
    </button>
    <button type="button" data-month="8" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 09
    </button>
    <button type="button" data-month="9" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 10
    </button>
    <button type="button" data-month="10" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 11
    </button>
    <button type="button" data-month="11" class="timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20">
      Month 12
    </button>
  </div>

  <!-- Active Month Detail Card -->
  <div id="month-card" class="mt-6 rounded-2xl bg-sap-sand dark:bg-[#0e223d] p-6 sm:p-8 border border-stone-200 dark:border-slate-700/80 transition-all duration-300">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-4">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="rounded-md bg-amber-100 dark:bg-amber-500/20 px-2.5 py-1 text-xs font-bold uppercase text-sap-terracotta dark:text-amber-300" id="month-badge">
            Term 1 • Month 01 • Foundation
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-medium" id="month-focus">
            Inward Alignment & Viveka
          </span>
        </div>

        <h4 class="font-serif text-2xl sm:text-3xl font-bold text-sap-navy dark:text-white" id="month-title">
          Inner Alignment & The Psychology of Power
        </h4>

        <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed" id="month-desc">
          Examining the shadow of ego in political life. Fellows undergo intensive self-reflection, mindfulness practices, and ethics discernment to build psychological immunity against corruption, vanity, and partisan hostility.
        </p>

        <div class="border-t border-stone-200 dark:border-slate-700/80 pt-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Key Modules Studied:</div>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700 dark:text-slate-300" id="month-modules">
            <li class="flex items-center gap-1.5">• <span>Ego, Power & The Moral Compass</span></li>
            <li class="flex items-center gap-1.5">• <span>Rajadharma: Ethics of Ancient Statecraft</span></li>
            <li class="flex items-center gap-1.5">• <span>Emotional Regulation Under Scrutiny</span></li>
            <li class="flex items-center gap-1.5">• <span>Authentic Leadership Foundations (Gardner et al.)</span></li>
          </ul>
        </div>
      </div>

      <!-- Sidebar Highlights -->
      <div class="lg:col-span-4 rounded-xl bg-white dark:bg-[#162d4a] p-5 border border-stone-200 dark:border-slate-700 space-y-4 shadow-sm">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-sap-terracotta dark:text-amber-400">Field Immersion / Circuit</span>
          <p class="text-xs font-semibold text-sap-navy dark:text-white mt-0.5" id="month-circuit">
            4-Day Opening Residential Retreat (Rishikesh / Himalayan Foothills)
          </p>
        </div>

        <div class="border-t border-stone-100 dark:border-slate-700/80 pt-3">
          <span class="text-[10px] font-bold uppercase tracking-wider text-sap-terracotta dark:text-amber-400">Practitioner Dialogue</span>
          <p class="text-xs font-semibold text-sap-navy dark:text-white mt-0.5" id="month-mentor">
            Masterclass with Former Supreme Court Jurist & Contemplative Mentors
          </p>
        </div>

        <div class="border-t border-stone-100 dark:border-slate-700/80 pt-3">
          <span class="text-[10px] font-bold uppercase tracking-wider text-sap-terracotta dark:text-amber-400">Tangible Deliverable</span>
          <p class="text-xs font-semibold text-slate-700 dark:text-slate-300 mt-0.5" id="month-deliverable">
            Personal Leadership Charter & Moral Code of Public Conduct
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const monthsData = [
    // TERM 1: Inward Mastery & Constitutional Foundations (Months 1–3)
    {
      termIndex: 0,
      badge: "Term 1 • Month 01 • Foundation",
      focus: "Inward Alignment & Viveka",
      title: "Inner Alignment & The Psychology of Power",
      desc: "Examining the shadow of ego in political life. Fellows undergo intensive self-reflection, mindfulness practices, and ethics discernment to build psychological immunity against corruption, vanity, and partisan hostility.",
      modules: [
        "Ego, Power & The Moral Compass",
        "Rajadharma: Ethics of Ancient Statecraft",
        "Emotional Regulation Under Scrutiny",
        "Authentic Leadership Foundations (Gardner et al.)"
      ],
      circuit: "4-Day Opening Residential Retreat (Rishikesh Foothills)",
      mentor: "Masterclass with Former Supreme Court Jurists & Contemplative Mentors",
      deliverable: "Personal Leadership Charter & Moral Code of Public Conduct"
    },
    {
      termIndex: 0,
      badge: "Term 1 • Month 02 • Constitutional Architecture",
      focus: "Constitutional Morality & Rights",
      title: "Constitutional Mechanics, Rights & Institutional Checks",
      desc: "Rigorous immersion in constitutional jurisprudence, separation of powers, legislative drafting procedure, and federal governance. Understanding the democratic machine from the inside out.",
      modules: [
        "Constitutional Morality & Landmark Jurisprudence",
        "Parliamentary Procedures & Committee Rules",
        "Federalism, State Autonomy & Separation of Powers",
        "Fundamental Rights vs Directive Principles"
      ],
      circuit: "Delhi Circuit: Parliament of India & Supreme Court Observation",
      mentor: "Dialogue with Senior Parliamentarians & Constitutional Scholars",
      deliverable: "Critical Judicial & Constitutional Audit of Landmark Legislation"
    },
    {
      termIndex: 0,
      badge: "Term 1 • Month 03 • Civilisational Philosophy",
      focus: "Comparative Political Thought",
      title: "Civilisational Statecraft & History of Democratic Ideas",
      desc: "Deconstruct timeless statecraft from ancient to modern eras. Examining Kautilya's Arthashastra, Ashoka's Dhamma, Thirukkural, alongside Western social contract theorists (Locke, Rousseau, Rawls) and modern Indian architects (Gandhi, Ambedkar).",
      modules: [
        "Arthashastra & Ashokan Edicts on Compassionate Governance",
        "Western Democratic Theory: Social Contract & Justice",
        "Gandhi, Ambedkar & Tagore: Decolonizing Leadership",
        "Pluralism, Religious Concord & Secular Harmony"
      ],
      circuit: "Historical Heritage Circuit (Nalanda, Rajgir & Ashokan Edicts)",
      mentor: "Seminars with Eminent Civilisational Historians & Political Theorists",
      deliverable: "Research Treatise on Civilisational Values Applied to Modern Crisis"
    },

    // TERM 2: Grassroots Realities, Municipal Governance & Public Finance (Months 4–6)
    {
      termIndex: 1,
      badge: "Term 2 • Month 04 • Grassroots Immersion",
      focus: "Lived Reality & Empathy",
      title: "Panchayati Raj & Ground-Level Listening Lab",
      desc: "Moving beyond urban policy think tanks into rural India. Fellows live alongside community members, observe Panchayati Raj governance (73rd Amendment), shadow block development officers, and learn village-level dispute mediation.",
      modules: [
        "Panchayati Raj System & Gram Sabhas in Action",
        "Agrarian Realities, Farm Distress & Rural Value Chains",
        "Social Audits & Participatory Democratic Budgeting",
        "Deep Listening Circles with Vulnerable & Marginalized Groups"
      ],
      circuit: "10-Day Deep Immersion in District Administrations & Gram Panchayats",
      mentor: "Roundtable with Grassroots Sarpanches & Rural IAS Collectors",
      deliverable: "Ground Reality Field Audit & Village Need-Assessment Whitepaper"
    },
    {
      termIndex: 1,
      badge: "Term 2 • Month 05 • Urban Systems",
      focus: "Cities, Infrastructure & Climate",
      title: "Urban Governance, Municipal Systems & Smart Infrastructure",
      desc: "Deconstructing modern municipal machinery (74th Amendment). From municipal bonds and ward committees to informal slum settlements, urban transit planning, waste management, and climate-resilient civil infrastructure.",
      modules: [
        "Urban Local Bodies, Mayor-in-Council & Municipal Acts",
        "Urban Housing, Slum Regularization & Informal Economies",
        "Transit Infrastructure, Water Sovereignty & Climate Risk",
        "Smart City Tech, Open Civic Data & Waste Ecosystems"
      ],
      circuit: "Metro Corporation Shadowing (Ward Engineers & Municipal Commissioners)",
      mentor: "Masterclass with Former Municipal Commissioners & Town Planners",
      deliverable: "Urban Civic Infrastructure Resilience & Service Delivery Blueprint"
    },
    {
      termIndex: 1,
      badge: "Term 2 • Month 06 • Public Finance",
      focus: "Fiscal Stewardship & Oversight",
      title: "Public Finance, Taxation & State Budgetary Deconstruction",
      desc: "Translating democratic mandates into budgetary realities. Fellows study union and state budgets, GST Council dynamics, fiscal deficit limits, public debt, procurement integrity, and forensic audit analysis.",
      modules: [
        "Union & State Budget Formulation Process",
        "Fiscal Deficit, Inflation Economics & Capital Expenditure",
        "GST Architecture & Federal Revenue Sharing Disputes",
        "Public Procurement Integrity & Forensic CAG Audit Analysis"
      ],
      circuit: "State Assembly Fiscal Policy Simulation & Treasury Briefing",
      mentor: "Working sessions with Former Union Finance Secretaries & Senior CAG Auditors",
      deliverable: "Forensic Line-Item Budget Analysis & Alternate Pro-People Budget Model"
    },

    // TERM 3: Policy Research Lab, Technology Ethics & Conscious Deliberation (Months 7–9)
    {
      termIndex: 2,
      badge: "Term 3 • Month 07 • Policy Lab",
      focus: "Applied Legislation & Science",
      title: "Policy Research Lab & Statutory Legislative Drafting",
      desc: "Translating moral conviction into rigorous statutory language. Fellows collaborate with economists, legal draftsmen, and researchers to draft comprehensive model bills addressing urgent national dilemmas.",
      modules: [
        "Statutory Drafting Grammar & Regulatory Impact Assessments",
        "Data-Driven Policy Analytics & Quantitative Econometrics",
        "Cross-Sectoral Tradeoff Modeling & Unintended Consequences",
        "Legislative Scrutiny: Standing Committees & Amendments"
      ],
      circuit: "National Policy Incubator & Drafting Hackathon (New Delhi)",
      mentor: "Working sessions with Senior Legislative Counsel & Think-Tank Fellows",
      deliverable: "Complete Model Statutory Bill with Explanatory Memorandum & Rules"
    },
    {
      termIndex: 2,
      badge: "Term 3 • Month 08 • Technology & Ethics",
      focus: "Frontier Tech & Future Governance",
      title: "Frontier AI Governance, Data Sovereignty & Climate Geopolitics",
      desc: "Understanding the technological and environmental frontiers shaping human society. Exploring ethical AI regulation, algorithmic surveillance, digital public infrastructure (UPI/Aadhaar/ONDC), data privacy, and global decarbonization treaties.",
      modules: [
        "Frontier AI Safety, Deepfakes & Algorithmic Accountability",
        "Digital Public Infrastructure & Citizen Privacy Rights",
        "Energy Transition, Carbon Markets & Just Climate Adaptation",
        "Global Technology Geopolitics & Semiconductor Supply Chains"
      ],
      circuit: "Tech Policy & Sustainability Summit (Bengaluru Tech Corridor)",
      mentor: "Consultations with Leading Tech Ethicists, Cyber Law Jurists & Climate Scientists",
      deliverable: "National Frontier AI Governance & Climate Adaptation Policy Framework"
    },
    {
      termIndex: 2,
      badge: "Term 3 • Month 09 • Depolarization",
      focus: "The Art of Deliberation",
      title: "Conscious Parliament Circles: Depolarization & Media Statecraft",
      desc: "Training in high-stakes deliberative diplomacy. Fellows engage in simulations of contentious national deadlocks, practicing non-adversarial debate, empathetic negotiation, consensus drafting, and media literacy under public glare.",
      modules: [
        "Non-Violent Civic Communication & Media Ecology",
        "Depolarization Strategies for Contested Social Dilemmas",
        "Consensus-Building with Ideological Opponents",
        "Ethical Media Engagement, Press Conferences & Crisis Comms"
      ],
      circuit: "3-Day National Mock Conscious Parliament Simulation",
      mentor: "Masterclass with Diplomatic Peace Negotiators & Veteran Statespeople",
      deliverable: "Bipartisan Consensus Accord on a Fractured National Dilemma"
    },

    // TERM 4: Electoral Integrity, Strategic Statesmanship & Capstone Launch (Months 10–12)
    {
      termIndex: 3,
      badge: "Term 4 • Month 10 • Clean Campaigns",
      focus: "Grassroots Organizing & Ethics",
      title: "Electoral Integrity, Field Organizing & Clean Political Finance",
      desc: "Demystifying elections while guarding against democratic decay. Fellows study the Representation of the People Act, booth-level volunteer mobilization, ethical voter outreach, countering misinformation, and radical transparency in political finance.",
      modules: [
        "Representation of the People Act & Election Commission Directives",
        "Grassroots Volunteer Mobilization & Voter Psychology",
        "Campaign Finance Reform & Eliminating Dark Money",
        "Dignified Civic Oratory & Ethical Door-to-Door Canvassing"
      ],
      circuit: "Constituency Field Organizing Simulation & Booth-Level Study",
      mentor: "Seminars with Former Chief Election Commissioners & Grassroots Campaign Architects",
      deliverable: "Ethical Constituency Action Plan & Model Transparent Campaign Budget"
    },
    {
      termIndex: 3,
      badge: "Term 4 • Month 11 • Crisis Statesmanship",
      focus: "Strategic Statecraft Under Fire",
      title: "Crisis Leadership, National Security & Geopolitical Strategy",
      desc: "Navigating unpredictable systemic crises. Fellows analyze defense doctrine, border diplomacy, humanitarian disaster management (NDMA), civil emergencies, and ethics under geopolitical pressure.",
      modules: [
        "Strategic Decision-Making Under Extreme Uncertainty",
        "National Security Doctrine & Neighborhood Diplomacy",
        "Disaster Management Logistics & Community Resilience",
        "Multilateral Treaties, Global Soft Power & UN Conventions"
      ],
      circuit: "High-Stakes Crisis War-Room Simulation (Disaster & Diplomatic Stand-off)",
      mentor: "Strategic Briefings by Retired Ambassadors, Defense Chiefs & Disaster Relief Leaders",
      deliverable: "National Crisis Response Protocol & Strategic Foreign Affairs Paper"
    },
    {
      termIndex: 3,
      badge: "Term 4 • Month 12 • Convocation & Launch",
      focus: "Lifetime Statesmanship & Induction",
      title: "Capstone Public Defense, Convocation & Statesmanship Induction",
      desc: "The culmination of the 1-year transformation. Fellows defend their 1-Year Public Transformation Capstone before an eminent board of statesmen and public leaders, receiving induction into the lifelong SAP Global Statesmanship Network.",
      modules: [
        "Public Defense of 1-Year Capstone Service Project",
        "Statesman Oratory: Delivering the Vision Address",
        "Building Values-Aligned Multidisciplinary Coalitions",
        "Lifelong Peer Accountability & Ethical Mentorship Circles"
      ],
      circuit: "Grand Convocation Ceremony & Public Governance Symposium (New Delhi)",
      mentor: "Keynote Addresses & Evaluation Jury of Eminent National & Global Leaders",
      deliverable: "Public Defense of 1-Year Capstone Initiative & Lifetime Statesmanship Induction"
    }
  ];

  function initTimeline() {
    const tabs = document.querySelectorAll('.timeline-tab');
    const termBtns = document.querySelectorAll('.term-btn');
    const badge = document.getElementById('month-badge');
    const focus = document.getElementById('month-focus');
    const title = document.getElementById('month-title');
    const desc = document.getElementById('month-desc');
    const modules = document.getElementById('month-modules');
    const circuit = document.getElementById('month-circuit');
    const mentor = document.getElementById('month-mentor');
    const deliverable = document.getElementById('month-deliverable');

    function setActiveMonth(index: number) {
      const data = monthsData[index];
      if (!data) return;

      // Update active month tab styling
      tabs.forEach((t, i) => {
        if (i === index) {
          t.className = 'timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-sap-navy dark:bg-amber-500 text-white dark:text-slate-950 shadow';
        } else {
          t.className = 'timeline-tab shrink-0 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20';
        }
      });

      // Update active term button styling
      termBtns.forEach((btn, tIdx) => {
        const jumpIdx = parseInt(btn.getAttribute('data-term-jump') || '0', 10);
        const isActiveTerm = (tIdx === data.termIndex);
        if (isActiveTerm) {
          btn.className = 'term-btn rounded-lg px-3 py-1.5 text-xs font-semibold uppercase tracking-wider transition bg-sap-navy dark:bg-amber-500 text-white dark:text-slate-950 shadow-sm';
        } else {
          btn.className = 'term-btn rounded-lg px-3 py-1.5 text-xs font-semibold uppercase tracking-wider transition bg-stone-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/20';
        }
      });

      // Update card content
      if (badge) badge.textContent = data.badge;
      if (focus) focus.textContent = data.focus;
      if (title) title.textContent = data.title;
      if (desc) desc.textContent = data.desc;
      if (circuit) circuit.textContent = data.circuit;
      if (mentor) mentor.textContent = data.mentor;
      if (deliverable) deliverable.textContent = data.deliverable;

      if (modules) {
        modules.innerHTML = data.modules.map(m => `
          <li class="flex items-center gap-1.5">• <span>${m}</span></li>
        `).join('');
      }

      // Scroll active tab into view smoothly
      const activeTab = tabs[index];
      if (activeTab) {
        activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const index = parseInt(tab.getAttribute('data-month') || '0', 10);
        setActiveMonth(index);
      });
    });

    termBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const jumpIndex = parseInt(btn.getAttribute('data-term-jump') || '0', 10);
        setActiveMonth(jumpIndex);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimeline);
  } else {
    initTimeline();
  }
</script>
