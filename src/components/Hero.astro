---
// src/components/Hero.astro
---

<section class="relative overflow-hidden bg-slate-950 py-20 sm:py-28 lg:py-32 text-white min-h-[92vh] flex items-center">
  <!-- Background Image: Vidhana Soudha / Parliament Architecture Highlighted in Full Glory -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/hero-parliament.jpg" 
      alt="School of Awakened Politics - Architecture of Governance" 
      class="h-full w-full object-cover object-[center_35%] filter brightness-105 contrast-105 saturate-115 scale-100"
    />
    <!-- Subtle top and bottom blend to integrate with navbar and the section below, while keeping the building brightly illuminated -->
    <div class="absolute inset-0 bg-gradient-to-t from-sap-navy via-transparent to-slate-950/40"></div>
    <!-- Soft dark vignette on the left to support the text panel -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/70 via-slate-950/20 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-2xl">
      <!-- Frosted Glass Card: Ensures 100% text legibility while letting the grand parliament architecture shine around it -->
      <div class="rounded-3xl bg-slate-950/75 backdrop-blur-md p-8 sm:p-10 border border-white/15 shadow-2xl space-y-6">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/60 bg-amber-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-amber-300">
          <span class="text-sm">🇮🇳</span>
          <span>Made In India For The World</span>
        </div>

        <!-- Main Headline -->
        <h1 class="font-serif text-3xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.14]">
          Welcome to <br />
          <span class="text-amber-300 drop-shadow">School of Awakened Politics</span>
        </h1>

        <!-- Slogan & Descriptor -->
        <p class="font-cinzel text-base sm:text-xl font-semibold tracking-wider text-amber-200">
          Lead From Your Authentic Self
        </p>

        <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-normal">
          <strong class="font-semibold text-white">Centre for Excellence in Leadership and Governance.</strong> 
          For those who aspire to lead from authenticity, empathy, and deep awareness — bridging the gap between inner transformation and societal stewardship.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <button
            type="button"
            class="trigger-apply-modal inline-flex items-center justify-center rounded-lg bg-sap-terracotta px-7 py-3.5 text-xs sm:text-sm font-semibold uppercase tracking-wider text-white shadow-lg hover:bg-sap-terracottaDark transition focus:outline-none focus:ring-2 focus:ring-amber-400"
          >
            Apply for Fellowship
            <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <a
            href="#global-circuits"
            class="inline-flex items-center justify-center rounded-lg border border-amber-400/60 bg-amber-500/15 px-6 py-3.5 text-xs sm:text-sm font-semibold text-amber-200 hover:bg-amber-500/30 hover:text-white transition"
          >
            Explore 3D Earth Globe ↓
          </a>

          <a
            href="#assessment"
            class="inline-flex items-center justify-center rounded-lg border border-white/30 bg-white/10 px-5 py-3.5 text-xs sm:text-sm font-semibold text-white hover:bg-white/20 transition"
          >
            60s Quiz ↓
          </a>
        </div>

        <!-- Trust Badges / Pillars -->
        <div class="pt-5 grid grid-cols-3 gap-3 border-t border-slate-700/80 text-center sm:text-left">
          <div>
            <div class="text-xs font-bold text-amber-300 uppercase tracking-wider">Non-Partisan</div>
            <div class="text-[11px] text-slate-300 mt-0.5">Stewardship charter</div>
          </div>
          <div>
            <div class="text-xs font-bold text-amber-300 uppercase tracking-wider">Inner Mastery</div>
            <div class="text-[11px] text-slate-300 mt-0.5">Self-awareness</div>
          </div>
          <div>
            <div class="text-xs font-bold text-amber-300 uppercase tracking-wider">Field Immersions</div>
            <div class="text-[11px] text-slate-300 mt-0.5">Real governance</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
