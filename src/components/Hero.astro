---
// src/components/Hero.astro
---

<section class="relative overflow-hidden bg-sap-navy py-24 sm:py-32 lg:py-36 text-white">
  <!-- Background Image with Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/hero-parliament.jpg" 
      alt="School of Awakened Politics - Architecture of Governance" 
      class="h-full w-full object-cover object-center scale-105 filter brightness-75 contrast-110"
    />
    <!-- Multi-layered overlay for optimal readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/80 to-slate-900/70"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-sap-navy via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl space-y-6">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-500/10 px-4 py-1.5 backdrop-blur-md">
        <span class="text-sm">🇮🇳</span>
        <span class="text-xs font-semibold uppercase tracking-widest text-amber-300">
          Made In India For The World
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-serif text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl leading-tight">
        Welcome to <br />
        <span class="text-amber-300">School of Awakened Politics</span>
      </h1>

      <!-- Slogan & Descriptor -->
      <p class="font-cinzel text-lg sm:text-xl font-semibold tracking-wider text-amber-200">
        Lead From Your Authentic Self
      </p>

      <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl font-normal">
        <span class="font-semibold text-white">Centre for Excellence in Leadership and Governance.</span> 
        For those who aspire to lead from authenticity, empathy, and deep awareness — bridging the gap between inner transformation and societal stewardship.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <button
          type="button"
          class="trigger-apply-modal inline-flex items-center justify-center rounded-lg bg-sap-terracotta px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-sap-terracotta/30 hover:bg-sap-terracottaDark transition focus:outline-none focus:ring-2 focus:ring-amber-400"
        >
          Apply for Fellowship
          <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>

        <a
          href="/fellowship"
          class="inline-flex items-center justify-center rounded-lg border border-slate-300/40 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur-sm hover:bg-white/20 transition"
        >
          Explore Fellowship Details
        </a>
      </div>

      <!-- Trust Badges / Pillars at bottom -->
      <div class="pt-8 grid grid-cols-1 gap-4 sm:grid-cols-3 border-t border-slate-700/60 mt-10">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/20 text-amber-300">
            ⚖️
          </div>
          <div>
            <div class="text-sm font-semibold text-white">Strictly Non-Partisan</div>
            <div class="text-xs text-slate-300">Focused on public stewardship</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/20 text-amber-300">
            🌱
          </div>
          <div>
            <div class="text-sm font-semibold text-white">Authentic Leadership</div>
            <div class="text-xs text-slate-300">Rooted in self-awareness & ethics</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/20 text-amber-300">
            🏛️
          </div>
          <div>
            <div class="text-sm font-semibold text-white">Real-World Exposure</div>
            <div class="text-xs text-slate-300">Immersion in policy & governance</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
