---
// src/components/Hero.astro
import InteractiveGlobe from './InteractiveGlobe.astro';
---

<section class="relative overflow-hidden bg-sap-navy py-16 sm:py-24 lg:py-28 text-white">
  <!-- Background Image with Radiant Architectural Illumination -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/hero-parliament.jpg" 
      alt="School of Awakened Politics - Architecture of Governance" 
      class="h-full w-full object-cover object-center filter brightness-95 contrast-105 saturate-110"
    />
    <!-- Text legibility gradient on the left, while highlighting the grand parliament dome & colonnades on the right -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/60 to-slate-950/20 lg:via-slate-950/45 lg:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-sap-navy via-sap-navy/30 to-transparent"></div>
    <!-- Warm amber architectural backlight glow -->
    <div class="absolute inset-0 bg-amber-500/10 mix-blend-screen pointer-events-none"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Column: Vision & Action -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-500/10 px-4 py-1.5 backdrop-blur-md">
          <span class="text-sm">🇮🇳</span>
          <span class="text-xs font-semibold uppercase tracking-widest text-amber-300">
            Made In India For The World
          </span>
        </div>

        <!-- Main Headline -->
        <h1 class="font-serif text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.15]">
          Welcome to <br />
          <span class="text-amber-300">School of Awakened Politics</span>
        </h1>

        <!-- Slogan & Descriptor -->
        <p class="font-cinzel text-lg sm:text-xl font-semibold tracking-wider text-amber-200">
          Lead From Your Authentic Self
        </p>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl font-normal">
          <strong class="font-semibold text-white">Centre for Excellence in Leadership and Governance.</strong> 
          For those who aspire to lead from authenticity, empathy, and deep awareness — bridging the gap between inner transformation and societal stewardship.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <button
            type="button"
            class="trigger-apply-modal inline-flex items-center justify-center rounded-lg bg-sap-terracotta px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-sap-terracotta/30 hover:bg-sap-terracottaDark transition focus:outline-none focus:ring-2 focus:ring-amber-400"
          >
            Apply for Fellowship
            <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <a
            href="#assessment"
            class="inline-flex items-center justify-center rounded-lg border border-amber-400/40 bg-white/10 px-6 py-3.5 text-sm font-semibold text-amber-200 backdrop-blur-sm hover:bg-white/20 hover:text-white transition"
          >
            Take 60s Leadership Quiz ↓
          </a>
        </div>

        <!-- Trust Badges / Pillars at bottom -->
        <div class="pt-6 grid grid-cols-1 gap-4 sm:grid-cols-3 border-t border-slate-700/60 mt-8">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/20 text-amber-300 text-lg">
              ⚖️
            </div>
            <div>
              <div class="text-xs font-semibold text-white uppercase tracking-wider">Non-Partisan</div>
              <div class="text-[11px] text-slate-300">Public stewardship charter</div>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/20 text-amber-300 text-lg">
              🌱
            </div>
            <div>
              <div class="text-xs font-semibold text-white uppercase tracking-wider">Inner Mastery</div>
              <div class="text-[11px] text-slate-300">Authentic self-awareness</div>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/20 text-amber-300 text-lg">
              🏛️
            </div>
            <div>
              <div class="text-xs font-semibold text-white uppercase tracking-wider">Field Immersions</div>
              <div class="text-[11px] text-slate-300">Real-world governance</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive 3D Leadership Globe -->
      <div class="lg:col-span-5 flex justify-center">
        <InteractiveGlobe />
      </div>
    </div>
  </div>
</section>
