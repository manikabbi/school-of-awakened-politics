---
// src/components/Hero.astro
---

<section class="relative overflow-hidden bg-sap-navy py-24 sm:py-32 lg:py-36 text-white min-h-[90vh] flex items-center">
  <!-- Background Image with Radiant Architectural Illumination (Parliament Model Highlighted) -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/hero-parliament.jpg" 
      alt="School of Awakened Politics - Architecture of Governance" 
      class="h-full w-full object-cover object-center filter brightness-100 contrast-105 saturate-115 scale-100 transition-all duration-700"
    />
    <!-- Delicate architectural gradient: protects text readability on the left, while leaving the grand parliament model, central dome & colonnades fully visible -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/60 to-slate-950/20 lg:via-slate-950/45 lg:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-sap-navy via-transparent to-slate-950/20"></div>
    <!-- Warm amber architectural backlight glow -->
    <div class="absolute inset-0 bg-amber-500/10 mix-blend-screen pointer-events-none"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-3xl space-y-7">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2.5 rounded-full border border-amber-400/60 bg-slate-950/80 px-4 py-1.5 backdrop-blur-md shadow-lg">
        <span class="text-sm">🇮🇳</span>
        <span class="text-xs font-semibold uppercase tracking-widest text-amber-300">
          Made In India For The World
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-serif text-4xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl leading-[1.12]">
        Welcome to <br />
        <span class="text-amber-300 drop-shadow-md">School of Awakened Politics</span>
      </h1>

      <!-- Slogan & Descriptor -->
      <p class="font-cinzel text-lg sm:text-2xl font-semibold tracking-wider text-amber-200">
        Lead From Your Authentic Self
      </p>

      <p class="text-base sm:text-lg text-slate-100 leading-relaxed max-w-2xl font-normal drop-shadow">
        <strong class="font-semibold text-white">Centre for Excellence in Leadership and Governance.</strong> 
        For those who aspire to lead from authenticity, empathy, and deep awareness — bridging the gap between inner transformation and societal stewardship.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <button
          type="button"
          class="trigger-apply-modal inline-flex items-center justify-center rounded-lg bg-sap-terracotta px-8 py-4 text-xs sm:text-sm font-semibold uppercase tracking-wider text-white shadow-xl shadow-sap-terracotta/30 hover:bg-sap-terracottaDark transition focus:outline-none focus:ring-2 focus:ring-amber-400"
        >
          APPLY FOR FELLOWSHIP →
        </button>

        <a
          href="#global-circuits"
          class="inline-flex items-center justify-center rounded-lg border border-amber-400/60 bg-slate-950/60 px-6 py-4 text-xs sm:text-sm font-semibold text-amber-200 backdrop-blur-md hover:bg-white/20 hover:text-white transition"
        >
          Explore Global Circuits ↓
        </a>

        <a
          href="#assessment"
          class="inline-flex items-center justify-center rounded-lg border border-white/30 bg-white/10 px-6 py-4 text-xs sm:text-sm font-semibold text-white backdrop-blur-md hover:bg-white/20 transition"
        >
          Take 60s Quiz ↓
        </a>
      <!-- Trust Pillars: Non-Partisan, Inner Mastery, Field Immersions -->
      <div class="pt-6 grid grid-cols-1 sm:grid-cols-3 gap-5 border-t border-slate-700/60 mt-8 max-w-2xl">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-500/20 border border-amber-400/30 text-amber-300 text-xl shadow-sm">
            ⚖️
          </div>
          <div>
            <div class="text-xs font-bold text-white uppercase tracking-wider">NON-PARTISAN</div>
            <div class="text-[11px] text-slate-300 mt-0.5">Public stewardship charter</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-500/20 border border-amber-400/30 text-amber-300 text-xl shadow-sm">
            🌱
          </div>
          <div>
            <div class="text-xs font-bold text-white uppercase tracking-wider">INNER MASTERY</div>
            <div class="text-[11px] text-slate-300 mt-0.5">Authentic self-awareness</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-500/20 border border-amber-400/30 text-amber-300 text-xl shadow-sm">
            🏛️
          </div>
          <div>
            <div class="text-xs font-bold text-white uppercase tracking-wider">FIELD IMMERSIONS</div>
            <div class="text-[11px] text-slate-300 mt-0.5">Real-world governance</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
