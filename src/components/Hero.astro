---
// src/components/Hero.astro
---

<section class="relative overflow-hidden bg-sap-navy text-white min-h-[calc(100vh-3.75rem)] flex flex-col justify-center pt-4 sm:pt-6 lg:pt-6 pb-6 sm:pb-8 lg:pb-8">
  <!-- Background Image with Radiant Architectural Illumination (Parliament Model Highlighted) -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/hero-parliament.jpg" 
      alt="School of Awakened Politics - Architecture of Governance" 
      class="h-full w-full object-cover object-center filter brightness-100 contrast-105 saturate-115 scale-100 transition-all duration-700"
    />
    <!-- Delicate architectural gradient: protects text readability on the left, while leaving the grand parliament model, central dome & colonnades fully visible -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/60 to-slate-950/20 lg:via-slate-950/45 lg:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-sap-navy via-transparent to-slate-950/20"></div>
    <!-- Warm amber architectural backlight glow -->
    <div class="absolute inset-0 bg-amber-500/10 mix-blend-screen pointer-events-none"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-3xl">
      <!-- Badges: Shifted up with crisp breathing room -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 mb-4 sm:mb-5 lg:mb-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/60 bg-slate-950/80 px-3.5 sm:px-4 py-1.5 backdrop-blur-md shadow-lg">
          <span class="text-xs sm:text-sm">🇮🇳</span>
          <span class="text-[11px] sm:text-xs font-semibold uppercase tracking-widest text-amber-300">
            Made In India For The World
          </span>
        </div>
        <a 
          href="https://www.findyouruniqueness.org" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1.5 sm:gap-2 rounded-full border border-amber-400/40 bg-slate-950/80 hover:bg-slate-900 px-3.5 sm:px-4 py-1.5 backdrop-blur-md shadow-lg text-[11px] sm:text-xs font-semibold uppercase tracking-widest text-amber-300/90 hover:text-white transition group"
        >
          <span class="text-xs">⚡</span>
          <span>Powered by Find Your Uniqueness</span>
          <span class="text-[10px] text-amber-400 group-hover:translate-x-0.5 transition-transform">↗</span>
        </a>
      </div>

      <!-- Main Headline: Balanced, readable typography -->
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-[3.1rem] xl:text-[3.5rem] font-bold tracking-tight text-white leading-[1.18] sm:leading-[1.14]">
        <span class="block text-lg sm:text-2xl lg:text-[1.75rem] font-light text-slate-200/90 mb-1.5 sm:mb-2 font-serif tracking-normal">Welcome to</span>
        <span class="text-amber-300 drop-shadow-md">School of Awakened Politics</span>
      </h1>

      <!-- Slogan & Descriptor: Distinct, breathable spacing -->
      <p class="mt-3.5 sm:mt-4 lg:mt-4.5 font-cinzel text-base sm:text-xl lg:text-2xl font-semibold tracking-wider text-amber-200">
        Lead From Your Authentic Self
      </p>

      <p class="mt-3 sm:mt-3.5 lg:mt-4 text-sm sm:text-base lg:text-[16px] text-slate-100/95 leading-relaxed max-w-2xl font-normal drop-shadow">
        <strong class="font-semibold text-white">Centre for Excellence in Leadership and Governance.</strong> 
        For those who aspire to lead from authenticity, empathy, and deep awareness — bridging the gap between inner transformation and societal stewardship.
      </p>

      <!-- Action Buttons: Shifted comfortably below text -->
      <div class="mt-5 sm:mt-6 lg:mt-7 flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 sm:gap-3.5">
        <button
          type="button"
          class="trigger-apply-modal w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-sap-terracotta px-6 sm:px-7 py-3 sm:py-3.5 text-xs sm:text-sm font-semibold uppercase tracking-wider text-white shadow-xl shadow-sap-terracotta/30 hover:bg-sap-terracottaDark transition focus:outline-none focus:ring-2 focus:ring-amber-400 text-center"
        >
          APPLY FOR FELLOWSHIP →
        </button>

        <a
          href="#global-circuits"
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-amber-400/60 bg-slate-950/60 px-5 sm:px-6 py-3 sm:py-3.5 text-xs sm:text-sm font-semibold text-amber-200 backdrop-blur-md hover:bg-white/20 hover:text-white transition text-center"
        >
          Explore Global Circuits ↓
        </a>

        <a
          href="#assessment"
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-white/30 bg-white/10 px-5 sm:px-6 py-3 sm:py-3.5 text-xs sm:text-sm font-semibold text-white backdrop-blur-md hover:bg-white/20 transition text-center"
        >
          Take 60s Quiz ↓
        </a>
      </div>

      <!-- Trust Pillars: Fully visible above the fold on all screens -->
      <div class="mt-5 sm:mt-6 lg:mt-7 pt-4 sm:pt-5 lg:pt-5 grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5 border-t border-slate-700/60 max-w-2xl">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-xl bg-amber-500/20 border border-amber-400/30 text-amber-300 text-lg shadow-sm">
            ⚖️
          </div>
          <div>
            <div class="text-xs font-bold text-white uppercase tracking-wider">NON-PARTISAN</div>
            <div class="text-[11px] text-slate-300 mt-0.5">Public stewardship charter</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-xl bg-amber-500/20 border border-amber-400/30 text-amber-300 text-lg shadow-sm">
            🌱
          </div>
          <div>
            <div class="text-xs font-bold text-white uppercase tracking-wider">INNER MASTERY</div>
            <div class="text-[11px] text-slate-300 mt-0.5">Authentic self-awareness</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-xl bg-amber-500/20 border border-amber-400/30 text-amber-300 text-lg shadow-sm">
            🏛️
          </div>
          <div>
            <div class="text-xs font-bold text-white uppercase tracking-wider">FIELD IMMERSIONS</div>
            <div class="text-[11px] text-slate-300 mt-0.5">Real-world governance</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
