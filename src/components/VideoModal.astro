---
// src/components/VideoModal.astro
---

<!-- Cinema Lightbox Modal for SAP Explainer Video -->
<div 
  id="video-explainer-modal" 
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/90 backdrop-blur-md p-4 sm:p-6 lg:p-8 transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="SAP Explainer Video Player"
>
  <div class="relative w-full max-w-4xl bg-[#071322] border border-amber-400/40 rounded-2xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col">
    <!-- Modal Header Bar -->
    <div class="flex items-center justify-between px-5 py-3.5 bg-slate-900/90 border-b border-slate-800">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex h-2 w-2 rounded-full bg-amber-400 shadow-[0_0_8px_#f59e0b]"></span>
        <span class="text-xs font-semibold uppercase tracking-wider text-amber-300">
          SAP Official Explainer
        </span>
        <span class="hidden sm:inline-block text-xs text-slate-400">|</span>
        <span class="hidden sm:inline-block text-xs text-slate-300 font-serif">
          Lead From Your Authentic Self
        </span>
      </div>

      <!-- Close Button -->
      <button 
        type="button" 
        id="close-video-modal-btn"
        class="rounded-full p-1.5 text-slate-400 hover:text-white hover:bg-white/10 transition"
        aria-label="Close video"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Video Wrapper (16:9 aspect ratio) -->
    <div class="relative w-full aspect-video bg-black flex items-center justify-center">
      <video
        id="modal-explainer-video"
        class="w-full h-full object-contain"
        controls
        playsinline
        preload="metadata"
        poster="/sap-explainer-poster.jpg"
      >
        <source src="/sap-explainer.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>

    <!-- Modal Footer Callout -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-5 py-3.5 bg-slate-950 border-t border-slate-800/80">
      <p class="text-xs text-slate-300 text-center sm:text-left">
        Narrated by <strong class="text-amber-300 font-semibold">Viraj</strong> with Hindustani Classical Sitar & Tanpura.
      </p>

      <button
        type="button"
        class="trigger-apply-modal text-xs font-semibold uppercase tracking-wider text-amber-300 hover:text-white hover:underline transition"
      >
        Apply for 1-Year Fellowship →
      </button>
    </div>
  </div>
</div>

<script>
  function setupVideoModal() {
    const modal = document.getElementById('video-explainer-modal');
    const video = document.getElementById('modal-explainer-video') as HTMLVideoElement | null;
    const closeBtn = document.getElementById('close-video-modal-btn');
    const triggers = document.querySelectorAll('.trigger-explainer-modal');

    if (!modal || !video) return;

    function openModal() {
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      document.body.classList.add('overflow-hidden');
      video?.play().catch(() => {});
    }

    function closeModal() {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
      if (video) {
        video.pause();
      }
    }

    triggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);

    // Click outside to close
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // ESC key to close
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  // Setup on initial load and client navigations
  setupVideoModal();
  document.addEventListener('astro:page-load', setupVideoModal);
</script>
