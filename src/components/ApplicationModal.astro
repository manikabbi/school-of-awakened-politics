---
// src/components/ApplicationModal.astro
---

<div id="application-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-950/75 backdrop-blur-sm transition-opacity">
  <div class="flex min-h-screen items-center justify-center p-4 sm:p-6">
    <div class="relative w-full max-w-lg rounded-2xl bg-white dark:bg-[#0b192c] p-6 sm:p-8 shadow-2xl border border-stone-200 dark:border-slate-700/80 transition-all">
      <!-- Close Button -->
      <button 
        type="button" 
        id="close-modal-btn"
        class="absolute right-4 top-4 rounded-full p-2 text-slate-400 hover:bg-stone-100 dark:hover:bg-white/10 hover:text-slate-700 dark:hover:text-white transition"
        aria-label="Close modal"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Header -->
      <div class="mb-6">
        <span class="inline-block rounded-full bg-amber-100 dark:bg-amber-500/20 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-sap-terracotta dark:text-amber-300">
          Leadership Fellowship
        </span>
        <h3 class="mt-2 text-2xl font-serif font-bold text-sap-navy dark:text-white">
          Apply to SAP Programs
        </h3>
        <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          Begin your journey towards authentic public leadership, conscious governance, and statesmanship.
        </p>
      </div>

      <!-- Application Form -->
      <form id="sap-application-form" class="space-y-4">
        <div>
          <label for="fullName" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Full Name <span class="text-rose-500">*</span>
          </label>
          <input 
            type="text" 
            id="fullName" 
            name="fullName" 
            required 
            placeholder="e.g. Aarav Sharma"
            class="mt-1 w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-stone-50 dark:bg-[#162d4a] px-4 py-2.5 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-400 focus:border-amber-500 dark:focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-500"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Email ID <span class="text-rose-500">*</span>
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="aarav@example.com"
            class="mt-1 w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-stone-50 dark:bg-[#162d4a] px-4 py-2.5 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-400 focus:border-amber-500 dark:focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-500"
          />
        </div>

        <div>
          <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Phone / WhatsApp Number <span class="text-rose-500">*</span>
          </label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            required 
            placeholder="+91 98765 43210"
            class="mt-1 w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-stone-50 dark:bg-[#162d4a] px-4 py-2.5 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-400 focus:border-amber-500 dark:focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-500"
          />
        </div>

        <div>
          <label for="program" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Program of Interest
          </label>
          <select 
            id="program" 
            name="program"
            class="mt-1 w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-stone-50 dark:bg-[#162d4a] px-4 py-2.5 text-sm text-slate-900 dark:text-white focus:border-amber-500 dark:focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-500"
          >
            <option value="world-leaders-fellowship">SAP World Leaders Fellowship (1-Year Post-Graduate Program)</option>
            <option value="governance-circuits">Governance Circuits (Immersive Study)</option>
            <option value="conscious-parliament">Conscious Parliament Circles</option>
            <option value="leadership-retreats">Leadership Retreats</option>
            <option value="policy-lab">Policy Research Lab</option>
            <option value="general-inquiry">General Inquiry / Collaboration</option>
          </select>
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label for="statement" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Why do you want to join SAP? <span class="text-rose-500">*</span>
            </label>
            <span class="text-[10px] text-slate-400 dark:text-slate-500">2–4 sentences</span>
          </div>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Share your motivation, your background, and what politics/public leadership means to you.
          </p>
          <textarea 
            id="statement" 
            name="statement" 
            rows="3" 
            required
            placeholder="e.g. I work in grassroots community initiatives. To me, politics is ethical stewardship and conscious governance. I want to join SAP to develop the statesmanship and leadership tools needed to drive authentic public reform..."
            class="mt-1.5 w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-stone-50 dark:bg-[#162d4a] px-4 py-2 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-400 focus:border-amber-500 dark:focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-500"
          ></textarea>
        </div>

        <div id="form-feedback" class="hidden rounded-xl p-3.5 text-xs font-medium space-y-1"></div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full rounded-lg bg-sap-terracotta px-6 py-3 text-sm font-semibold uppercase tracking-wider text-white shadow-md hover:bg-sap-terracottaDark transition focus:outline-none focus:ring-2 focus:ring-amber-400 active:scale-[0.99]"
        >
          Submit Application
        </button>
      </form>

      <div class="mt-4 pt-3 border-t border-stone-200 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
        <span>Inquiries: <a href="mailto:info@schoolofawakenedpolitics.org" class="text-sap-terracotta dark:text-amber-400 underline">info@schoolofawakenedpolitics.org</a></span>
        <button type="button" id="open-admin-ledger-btn" class="hover:underline text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" title="Admin View of Stored Applications">Admin Ledger 📋</button>
      </div>
    </div>
  </div>
</div>

<!-- Admin Applications Ledger Modal (Safe Local Storage & Export to CSV / Google Sheet) -->
<div id="admin-ledger-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-950/80 backdrop-blur-md">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="relative w-full max-w-3xl rounded-2xl bg-white dark:bg-[#0b192c] p-6 shadow-2xl border border-stone-200 dark:border-slate-700">
      <div class="flex items-center justify-between border-b border-stone-200 dark:border-slate-800 pb-4 mb-4">
        <div>
          <h3 class="text-lg font-serif font-bold text-sap-navy dark:text-white">
            SAP Admissions Database & Application Ledger
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Real-time applications received. Synced with Email Notification & Google Sheet database.
          </p>
        </div>
        <button type="button" id="close-admin-ledger-btn" class="rounded-full p-1.5 text-slate-400 hover:bg-stone-100 dark:hover:bg-white/10 hover:text-slate-700 dark:hover:text-white">
          ✕
        </button>
      </div>

      <!-- Actions Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="text-xs font-semibold text-slate-700 dark:text-slate-300" id="ledger-count-text">
          Total Applications: 0
        </div>
        <div class="flex items-center gap-2">
          <button type="button" id="export-csv-btn" class="rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white shadow">
            Export to Excel / CSV 📊
          </button>
          <button type="button" id="clear-ledger-btn" class="rounded-lg border border-rose-300 dark:border-rose-800 px-3 py-1.5 text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30">
            Clear Local Copy
          </button>
        </div>
      </div>

      <!-- Google Sheet Webhook Config Info -->
      <div class="mb-4 rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-400/30 p-3 text-xs text-slate-700 dark:text-amber-200">
        <div class="font-bold text-amber-800 dark:text-amber-300 mb-1">🔗 Dual-Pipeline Active:</div>
        <div>1. <strong>Direct Email:</strong> Dispatches notifications to <code>info@schoolofawakenedpolitics.org</code></div>
        <div>2. <strong>Google Sheet Sync:</strong> Connects to your Google Sheet webhook. Optional custom webhook URL can be set below:</div>
        <div class="mt-2 flex gap-2">
          <input 
            type="url" 
            id="sheet-webhook-input" 
            placeholder="https://script.google.com/macros/s/.../exec (Paste Google Apps Script Web App URL)" 
            class="flex-1 rounded-md border border-amber-300 dark:border-slate-600 bg-white dark:bg-[#162d4a] px-2.5 py-1 text-xs text-slate-900 dark:text-white"
          />
          <button type="button" id="save-webhook-btn" class="rounded-md bg-sap-terracotta px-3 py-1 text-xs font-semibold text-white hover:bg-sap-terracottaDark">
            Save Webhook
          </button>
        </div>
      </div>

      <!-- Table View -->
      <div class="max-h-72 overflow-y-auto rounded-xl border border-stone-200 dark:border-slate-800">
        <table class="w-full text-left text-xs">
          <thead class="bg-stone-100 dark:bg-[#162d4a] text-slate-700 dark:text-slate-300 font-semibold sticky top-0">
            <tr>
              <th class="p-2.5">Date</th>
              <th class="p-2.5">Ref ID</th>
              <th class="p-2.5">Name</th>
              <th class="p-2.5">Email</th>
              <th class="p-2.5">Phone</th>
              <th class="p-2.5">Program</th>
            </tr>
          </thead>
          <tbody id="ledger-table-body" class="divide-y divide-stone-200 dark:divide-slate-800 text-slate-600 dark:text-slate-300">
            <tr>
              <td colspan="6" class="p-4 text-center text-slate-400">No applications recorded yet.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  interface ApplicationRecord {
    id: string;
    timestamp: string;
    fullName: string;
    email: string;
    phone: string;
    program: string;
    archetype?: string;
    statement: string;
  }

  function getStoredApplications(): ApplicationRecord[] {
    try {
      const data = localStorage.getItem('sap_applications');
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveStoredApplications(records: ApplicationRecord[]) {
    try {
      localStorage.setItem('sap_applications', JSON.stringify(records));
    } catch (e) {
      console.warn('LocalStorage error:', e);
    }
  }

  function setupApplicationSystem() {
    const modal = document.getElementById('application-modal');
    const closeBtn = document.getElementById('close-modal-btn');
    const openBtns = document.querySelectorAll('.trigger-apply-modal');
    const form = document.getElementById('sap-application-form') as HTMLFormElement | null;
    const feedback = document.getElementById('form-feedback');
    const submitBtn = document.getElementById('submit-btn');

    // Admin Ledger Elements
    const adminLedgerModal = document.getElementById('admin-ledger-modal');
    const openAdminBtn = document.getElementById('open-admin-ledger-btn');
    const closeAdminBtn = document.getElementById('close-admin-ledger-btn');
    const exportCsvBtn = document.getElementById('export-csv-btn');
    const clearLedgerBtn = document.getElementById('clear-ledger-btn');
    const webhookInput = document.getElementById('sheet-webhook-input') as HTMLInputElement | null;
    const saveWebhookBtn = document.getElementById('save-webhook-btn');
    const tableBody = document.getElementById('ledger-table-body');
    const countText = document.getElementById('ledger-count-text');

    // Load saved webhook URL
    if (webhookInput) {
      webhookInput.value = localStorage.getItem('sap_sheets_webhook_url') || '';
    }

    saveWebhookBtn?.addEventListener('click', () => {
      if (webhookInput) {
        localStorage.setItem('sap_sheets_webhook_url', webhookInput.value.trim());
        alert('Google Sheets Webhook URL successfully saved! Future submissions will post to this sheet.');
      }
    });

    function renderLedger() {
      const records = getStoredApplications();
      if (countText) countText.textContent = `Total Applications: ${records.length}`;
      if (!tableBody) return;

      if (records.length === 0) {
        tableBody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-400">No applications recorded yet.</td></tr>`;
        return;
      }

      tableBody.innerHTML = records.map(r => `
        <tr class="hover:bg-stone-50 dark:hover:bg-white/5 transition">
          <td class="p-2.5 whitespace-nowrap text-[11px]">${new Date(r.timestamp).toLocaleDateString()}</td>
          <td class="p-2.5 font-mono text-[11px] text-amber-600 dark:text-amber-400 font-bold">${r.id}</td>
          <td class="p-2.5 font-medium text-slate-900 dark:text-white">${r.fullName}</td>
          <td class="p-2.5"><a href="mailto:${r.email}" class="text-sap-terracotta dark:text-amber-300 hover:underline">${r.email}</a></td>
          <td class="p-2.5 whitespace-nowrap">${r.phone || '—'}</td>
          <td class="p-2.5">${r.program}</td>
        </tr>
      `).join('');
    }

    openAdminBtn?.addEventListener('click', () => {
      renderLedger();
      if (adminLedgerModal) adminLedgerModal.classList.remove('hidden');
    });

    closeAdminBtn?.addEventListener('click', () => {
      if (adminLedgerModal) adminLedgerModal.classList.add('hidden');
    });

    adminLedgerModal?.addEventListener('click', (e) => {
      if (e.target === adminLedgerModal) adminLedgerModal.classList.add('hidden');
    });

    // Keyboard shortcut Ctrl+Shift+A opens Admin Ledger
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'A' || e.key === 'a')) {
        renderLedger();
        if (adminLedgerModal) adminLedgerModal.classList.toggle('hidden');
      }
    });

    clearLedgerBtn?.addEventListener('click', () => {
      if (confirm('Clear local browser copy of applications? (External emails and Google Sheet are unaffected)')) {
        saveStoredApplications([]);
        renderLedger();
      }
    });

    exportCsvBtn?.addEventListener('click', () => {
      const records = getStoredApplications();
      if (records.length === 0) {
        alert('No applications to export.');
        return;
      }
      const headers = ['Ref ID', 'Timestamp', 'Full Name', 'Email', 'Phone', 'Program', 'Civic Archetype', 'Why Join & Politics Vision'];
      const csvRows = [headers.join(',')];
      records.forEach(r => {
        const row = [
          `"${r.id}"`,
          `"${r.timestamp}"`,
          `"${r.fullName.replace(/"/g, '""')}"`,
          `"${r.email.replace(/"/g, '""')}"`,
          `"${r.phone.replace(/"/g, '""')}"`,
          `"${r.program.replace(/"/g, '""')}"`,
          `"${(r.archetype || 'Not taken').replace(/"/g, '""')}"`,
          `"${(r.statement || '').replace(/"/g, '""')}"`
        ];
        csvRows.push(row.join(','));
      });
      const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `SAP_Applications_${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Modal open / close
    function openModal() {
      if (modal) modal.classList.remove('hidden');
    }

    function closeModal() {
      if (modal) modal.classList.add('hidden');
    }

    openBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Dual-Pipeline Form Submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) submitBtn.textContent = 'Submitting Application...';

      const formData = new FormData(form);
      const refId = `SAP-2026-${Date.now().toString(36).toUpperCase()}`;

      let userArchetype = 'Not taken';
      try {
        const storedArch = localStorage.getItem('sap_last_archetype');
        if (storedArch) {
          const parsed = JSON.parse(storedArch);
          userArchetype = parsed.title || 'Not taken';
        }
      } catch (e) {}

      const record: ApplicationRecord = {
        id: refId,
        timestamp: new Date().toISOString(),
        fullName: String(formData.get('fullName') || ''),
        email: String(formData.get('email') || ''),
        phone: String(formData.get('phone') || ''),
        program: String(formData.get('program') || ''),
        archetype: userArchetype,
        statement: String(formData.get('statement') || '')
      };

      // 1. Safety Pipeline: Local Storage Ledger
      const existing = getStoredApplications();
      existing.unshift(record);
      saveStoredApplications(existing);

      // 2. Email Pipeline: Hostinger Native Server Mailer to info@schoolofawakenedpolitics.org
      const emailPromise = fetch('/api/notify.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          formType: 'application',
          ...record
        })
      }).catch(err => {
        console.warn('Email dispatch warning (handled):', err);
      });

      // 3. Database / Google Sheet Pipeline: POST to Webhook
      const DEFAULT_SHEET_WEBHOOK = 'https://script.google.com/macros/s/AKfycbzpRq6ml91ESkW4NmHUD2P0SVJQDppcEUvewRrHc6tO8QlldQgEWXbWsp3weAXM8f_Q/exec';
      const sheetUrl = localStorage.getItem('sap_sheets_webhook_url') || DEFAULT_SHEET_WEBHOOK;
      let sheetPromise: Promise<any> | null = null;
      if (sheetUrl && sheetUrl.startsWith('http')) {
        sheetPromise = fetch(sheetUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            formType: 'application',
            ...record
          })
        }).catch(err => {
          console.warn('Google Sheet dispatch warning (handled):', err);
        });
      }

      await Promise.allSettled([emailPromise, sheetPromise].filter(Boolean));

      // Display rich success feedback
      if (feedback) {
        feedback.classList.remove('hidden');
        feedback.className = 'rounded-xl p-4 text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-200 border border-emerald-300 dark:border-emerald-700/60 space-y-1.5';
        feedback.innerHTML = `
          <div class="flex items-center gap-1.5 font-bold text-emerald-800 dark:text-emerald-300 text-sm">
            <span>✓</span> Application Successfully Registered!
          </div>
          <div>Reference ID: <strong class="font-mono">${refId}</strong></div>
          <div class="text-[11px] text-emerald-700 dark:text-emerald-300/80">
            • <strong>Email Notification:</strong> Dispatched to admissions (info@schoolofawakenedpolitics.org)<br/>
            • <strong>Database Record:</strong> Recorded in official registry & admissions ledger.<br/>
            Our team will review your application and contact you within 48 hours.
          </div>
        `;
      }

      form.reset();
      if (submitBtn) submitBtn.textContent = 'Application Received ✓';

      setTimeout(() => {
        closeModal();
        if (submitBtn) submitBtn.textContent = 'Submit Application';
        if (feedback) feedback.classList.add('hidden');
      }, 4500);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupApplicationSystem);
  } else {
    setupApplicationSystem();
  }
</script>
