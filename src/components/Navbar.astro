---
// src/components/Navbar.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About SAP' },
  { href: '/vision-mission', label: 'Vision & Mission' },
  { href: '/fellowship', label: 'Fellowship' },
  { href: '/courses', label: 'Programs' },
  { href: '/blogs', label: 'Publishing' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-stone-200 dark:border-slate-800/80 bg-[#fbf8f2]/95 dark:bg-[#0b192c]/95 backdrop-blur-md transition-colors duration-200">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand Logo Lockup: Centered Emblem + Prominent Typography -->
    <a href="/" class="group flex items-center gap-3.5 transition py-0.5">
      <div class="flex h-12 w-12 sm:h-14 sm:w-14 shrink-0 items-center justify-center rounded-xl bg-amber-500/10 dark:bg-white/5 border border-amber-400/30 p-1 group-hover:scale-105 transition-transform shadow-sm">
        <img 
          src="/logo.svg" 
          alt="School of Awakened Politics Emblem" 
          class="h-full w-full object-contain"
        />
      </div>
      
      <div class="flex flex-col justify-center">
        <div class="flex items-center gap-2">
          <span class="font-cinzel text-base sm:text-lg font-bold tracking-wider text-sap-terracotta dark:text-amber-400 group-hover:text-amber-500 transition">
            SAP
          </span>
          <span class="h-3.5 w-px bg-stone-300 dark:bg-slate-700 inline-block"></span>
          <span class="font-serif text-sm sm:text-base lg:text-lg font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-sap-terracotta dark:group-hover:text-amber-200 transition">
            School of Awakened Politics
          </span>
        </div>
        <div class="flex items-center gap-2 mt-0.5">
          <span class="font-cinzel text-[11px] sm:text-xs font-semibold tracking-wider text-sap-terracotta dark:text-amber-300/95 uppercase">
            Lead from Your Authentic Self
          </span>
          <span class="text-stone-300 dark:text-slate-700 text-xs hidden md:inline">•</span>
          <span class="hidden md:inline-flex items-center text-[10.5px] font-medium text-amber-700 dark:text-amber-300/90 tracking-wide">
            Powered by <a href="https://www.findyouruniqueness.org" target="_blank" rel="noopener noreferrer" class="underline hover:text-sap-terracotta dark:hover:text-amber-200 ml-1">Find Your Uniqueness</a>
          </span>
        </div>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-7">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`text-sm font-medium transition py-1 border-b-2 ${
              isActive
                ? 'text-sap-terracotta dark:text-amber-300 font-semibold border-sap-terracotta dark:border-amber-400'
                : 'text-slate-700 dark:text-slate-300 hover:text-sap-navy dark:hover:text-amber-200 border-transparent hover:border-sap-terracotta/40 dark:hover:border-amber-400/50'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Actions: Theme Switcher + CTA -->
    <div class="flex items-center gap-3">
      <!-- Light / Dark Theme Switcher Button -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-stone-300 dark:border-slate-700 bg-stone-100 dark:bg-white/5 text-slate-700 dark:text-amber-300 hover:bg-stone-200 dark:hover:bg-white/15 hover:scale-105 transition focus:outline-none"
        title="Toggle Light / Dark Theme"
        aria-label="Toggle theme"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-sun-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-moon-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Apply Now CTA -->
      <button
        type="button"
        class="trigger-apply-modal rounded-full bg-sap-terracotta px-5 py-2 text-xs font-semibold uppercase tracking-wider text-white shadow-md hover:bg-sap-terracottaDark transition focus:outline-none focus:ring-2 focus:ring-amber-400"
      >
        Apply Now
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex rounded-lg p-2 text-slate-700 dark:text-slate-300 hover:bg-stone-100 dark:hover:bg-white/10 lg:hidden focus:outline-none"
        aria-label="Toggle navigation menu"
      >
        <svg id="menu-icon-bars" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="hidden border-b border-stone-200 dark:border-slate-800 bg-[#fbf8f2] dark:bg-[#0b192c]">
    <div class="space-y-1 px-4 pb-4 pt-2">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`block rounded-lg px-3 py-2 text-base font-medium transition ${
              isActive
                ? 'bg-amber-500/15 text-sap-terracotta dark:text-amber-300 font-semibold'
                : 'text-slate-700 dark:text-slate-300 hover:bg-stone-200 dark:hover:bg-white/5'
            }`}
          >
            {link.label}
          </a>
        );
      })}
      <div class="pt-3">
        <button
          type="button"
          class="trigger-apply-modal w-full rounded-lg bg-sap-terracotta py-2.5 text-center text-xs font-semibold uppercase tracking-wider text-white shadow"
        >
          Apply Now
        </button>
      </div>
      <div class="pt-2 text-center">
        <a
          href="https://www.findyouruniqueness.org"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs text-amber-600 dark:text-amber-400 font-medium hover:underline py-1"
        >
          <span>Powered by Find Your Uniqueness</span>
          <span class="text-[10px]">↗</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    // 1. Mobile Menu Toggle
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');

    toggleBtn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
      iconBars?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });

    // 2. Light / Dark Theme Switcher Logic
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-sun-icon');
    const moonIcon = document.getElementById('theme-moon-icon');

    function updateIcons(isDark: boolean) {
      if (isDark) {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }

    const isDarkInit = document.documentElement.classList.contains('dark');
    updateIcons(isDarkInit);

    themeBtn?.addEventListener('click', () => {
      const isCurrentlyDark = document.documentElement.classList.contains('dark');
      if (isCurrentlyDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('sap-theme', 'light');
        updateIcons(false);
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('sap-theme', 'dark');
        updateIcons(true);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNavbar);
  } else {
    setupNavbar();
  }
</script>
