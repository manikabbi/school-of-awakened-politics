---
// src/components/InteractiveGlobe.astro
---

<div class="relative w-full max-w-4xl mx-auto flex flex-col items-center select-none py-2">
  <!-- Glowing golden & cosmic aura -->
  <div class="absolute inset-0 bg-gradient-to-r from-amber-500/25 via-orange-500/15 to-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>

  <!-- 3D Three.js Container -->
  <div class="relative w-[340px] h-[340px] sm:w-[480px] sm:h-[480px] md:w-[560px] md:h-[560px] flex items-center justify-center">
    <div 
      id="globe-three-container" 
      class="w-full h-full cursor-grab active:cursor-grabbing"
    ></div>

    <!-- Overlay Tooltip for Hubs -->
    <div 
      id="globe-tooltip" 
      class="pointer-events-none absolute opacity-0 transition-opacity duration-200 rounded-lg bg-slate-950/95 border border-amber-400 px-3.5 py-2 text-xs text-white shadow-2xl backdrop-blur-md z-30 whitespace-nowrap"
    >
      <div id="tooltip-city" class="font-bold text-amber-300 text-sm flex items-center gap-1.5">New Delhi</div>
      <div id="tooltip-role" class="text-[11px] text-slate-300 font-medium mt-0.5">Centre for Awakened Governance</div>
    </div>

    <!-- Interactive Recenter Floating Control -->
    <button 
      id="recenter-india-btn"
      type="button" 
      class="absolute bottom-4 right-4 flex items-center gap-1.5 rounded-full bg-slate-950/90 hover:bg-amber-950 border border-amber-400/80 px-3.5 py-1.5 text-xs font-bold tracking-wider text-amber-300 backdrop-blur-md shadow-2xl transition-all hover:scale-105 active:scale-95 z-20"
      title="Recenter camera on India"
    >
      <span>🎯</span>
      <span>Recenter on India</span>
    </button>
  </div>

  <!-- Legend & Outward Radiation Indicator -->
  <div class="mt-4 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-300">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-amber-400 shadow-md shadow-amber-400/80 ring-2 ring-amber-300/40"></span>
      <span class="font-bold text-white text-sm">Real 3D Earth • Bharat (India) at Center</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 shadow-sm shadow-cyan-400/80"></span>
      <span class="text-slate-200">Cities with Names Displayed</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-block w-5 h-0.5 bg-gradient-to-r from-amber-400 to-cyan-400"></span>
      <span class="text-amber-300 font-semibold">Light Radiation from India</span>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  function initRealEarthGlobe() {
    const container = document.getElementById('globe-three-container');
    const tooltip = document.getElementById('globe-tooltip');
    const tooltipCity = document.getElementById('tooltip-city');
    const tooltipRole = document.getElementById('tooltip-role');
    const recenterBtn = document.getElementById('recenter-india-btn');
    if (!container) return;

    const width = container.clientWidth || 540;
    const height = container.clientHeight || 540;

    // Three.js Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 2.85;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.innerHTML = '';
    container.appendChild(renderer.domElement);

    const R = 1.0;

    // Lighting: Realistic Golden Sun on India
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.35);
    scene.add(ambientLight);

    const sunLight = new THREE.DirectionalLight(0xfff5e6, 2.0);
    sunLight.position.set(2.5, 2, 4);
    scene.add(sunLight);

    // Root Group for interactive rotation
    const globeGroup = new THREE.Group();
    scene.add(globeGroup);

    // Load Realistic Photorealistic Earth Texture
    const textureLoader = new THREE.TextureLoader();
    const earthTexture = textureLoader.load('/earth-blue-marble.jpg');
    earthTexture.colorSpace = THREE.SRGBColorSpace;

    // Earth Mesh
    const earthGeo = new THREE.SphereGeometry(R, 64, 64);
    const earthMat = new THREE.MeshStandardMaterial({
      map: earthTexture,
      roughness: 0.6,
      metalness: 0.1
    });
    const earthMesh = new THREE.Mesh(earthGeo, earthMat);
    globeGroup.add(earthMesh);

    // Lat/Lon to Vector3 helper
    function latLonToVector3(lat: number, lon: number, radius: number): THREE.Vector3 {
      const phi = (90 - lat) * (Math.PI / 180);
      const theta = (lon + 180) * (Math.PI / 180);
      const x = -radius * Math.sin(phi) * Math.cos(theta);
      const z = radius * Math.sin(phi) * Math.sin(theta);
      const y = radius * Math.cos(phi);
      return new THREE.Vector3(x, y, z);
    }

    // Helper: Create Text Sprite with city name
    function createTextSprite(text: string, isHome: boolean = false): THREE.Sprite {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = 384;
      canvas.height = 96;

      if (ctx) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Pill background
        ctx.fillStyle = isHome ? "rgba(245, 158, 11, 0.9)" : "rgba(11, 25, 44, 0.85)";
        ctx.strokeStyle = isHome ? "#fef08a" : "rgba(56, 189, 248, 0.8)";
        ctx.lineWidth = 3;

        const padX = 14;
        const padY = 16;
        const pillW = canvas.width - padX * 2;
        const pillH = canvas.height - padY * 2;
        const radius = 18;

        ctx.beginPath();
        ctx.roundRect(padX, padY, pillW, pillH, radius);
        ctx.fill();
        ctx.stroke();

        // City Name Text
        ctx.font = isHome ? "bold 32px sans-serif" : "600 28px sans-serif";
        ctx.fillStyle = isHome ? "#0b192c" : "#ffffff";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(text, canvas.width / 2, canvas.height / 2);
      }

      const texture = new THREE.CanvasTexture(canvas);
      texture.minFilter = THREE.LinearFilter;
      const spriteMat = new THREE.SpriteMaterial({
        map: texture,
        transparent: true,
        depthTest: false
      });
      const sprite = new THREE.Sprite(spriteMat);
      sprite.scale.set(isHome ? 0.42 : 0.32, isHome ? 0.105 : 0.08, 1);
      return sprite;
    }

    // India Subcontinent Border Coordinates
    const indiaPolygon: [number, number][] = [
      [35.5, 74.8], [34.5, 77.5], [32.0, 78.8], [30.5, 80.8], [28.0, 84.0], [27.5, 88.5], 
      [27.0, 92.5], [28.2, 96.5], [26.5, 95.0], [24.5, 93.5], [22.5, 91.8], [21.5, 87.0], 
      [19.0, 85.0], [16.0, 81.0], [13.0, 80.2], [10.0, 79.8], [8.0, 77.5], // Kanyakumari
      [9.5, 76.2], [12.0, 75.0], [15.5, 73.5], [19.0, 72.8], [21.0, 72.5], [22.5, 69.0], // Gujarat
      [24.5, 68.5], [27.0, 71.0], [30.5, 73.5], [33.0, 74.0], [35.5, 74.8]
    ];

    // 3D Golden Boundary around India
    const indiaLinePoints: THREE.Vector3[] = [];
    indiaPolygon.forEach(([lat, lon]) => {
      indiaLinePoints.push(latLonToVector3(lat, lon, R * 1.008));
    });
    const indiaLineGeo = new THREE.BufferGeometry().setFromPoints(indiaLinePoints);
    const indiaLineMat = new THREE.LineBasicMaterial({
      color: 0xfbbf24,
      linewidth: 3
    });
    const indiaLine = new THREE.Line(indiaLineGeo, indiaLineMat);
    globeGroup.add(indiaLine);

    // Global Governance Cities
    const hubs = [
      { name: "★ New Delhi (SAP Core)", role: "Centre for Awakened Governance & Rajadharma", lat: 28.61, lon: 77.20, isHome: true },
      { name: "Geneva", role: "Multilateral Human Rights & International Law", lat: 46.20, lon: 6.14, isHome: false },
      { name: "London", role: "Parliamentary Jurisprudence & Commonwealth", lat: 51.50, lon: -0.12, isHome: false },
      { name: "Dubai", role: "Middle Eastern Strategic Crossroads", lat: 25.20, lon: 55.27, isHome: false },
      { name: "Nairobi", role: "Global South Ecological & Public Stewardship", lat: -1.29, lon: 36.82, isHome: false },
      { name: "Singapore", role: "Asian Governance & Innovation Hub", lat: 1.35, lon: 103.81, isHome: false },
      { name: "Tokyo", role: "Democratic Technology & Consensus Governance", lat: 35.67, lon: 139.65, isHome: false },
      { name: "Washington D.C.", role: "Constitutional Systems & Global Policy", lat: 38.90, lon: -77.03, isHome: false },
      { name: "Sydney", role: "Pacific Democratic & Institutional Circuit", lat: -33.86, lon: 151.20, isHome: false }
    ];

    const hubMarkers: { mesh: THREE.Mesh; sprite: THREE.Sprite; hub: any }[] = [];
    const delhiPos = latLonToVector3(28.61, 77.20, R * 1.012);

    hubs.forEach((hub) => {
      const pos = latLonToVector3(hub.lat, hub.lon, R * 1.012);

      // Marker Sphere
      const markerGeo = new THREE.SphereGeometry(hub.isHome ? 0.024 : 0.016, 16, 16);
      const markerMat = new THREE.MeshBasicMaterial({
        color: hub.isHome ? 0xf59e0b : 0x38bdf8
      });
      const marker = new THREE.Mesh(markerGeo, markerMat);
      marker.position.copy(pos);
      globeGroup.add(marker);

      // Permanent City Name Sprite
      const sprite = createTextSprite(hub.name, hub.isHome);
      // Place label just above the marker
      const labelOffset = pos.clone().normalize().multiplyScalar(0.06);
      sprite.position.copy(pos).add(labelOffset);
      globeGroup.add(sprite);

      hubMarkers.push({ mesh: marker, sprite, hub });
    });

    // Golden Concentric Wave Rings Expanding from New Delhi
    const pulseRingGeo = new THREE.RingGeometry(0.015, 0.05, 32);
    const pulseRingMat = new THREE.MeshBasicMaterial({
      color: 0xf59e0b,
      side: THREE.DoubleSide,
      transparent: true,
      opacity: 0.85
    });
    const pulseRing = new THREE.Mesh(pulseRingGeo, pulseRingMat);
    pulseRing.position.copy(latLonToVector3(28.61, 77.20, R * 1.014));
    pulseRing.lookAt(delhiPos.clone().multiplyScalar(2));
    globeGroup.add(pulseRing);

    // 3D Light Arcs & Outward Light Beams Streaming from India to Cities
    interface ArcData {
      curve: THREE.QuadraticBezierCurve3;
      pulse1: THREE.Mesh;
      pulse2: THREE.Mesh;
      offset: number;
    }
    const arcs: ArcData[] = [];

    hubs.filter(h => !h.isHome).forEach((target, index) => {
      const targetPos = latLonToVector3(target.lat, target.lon, R * 1.012);
      const mid = delhiPos.clone().add(targetPos).multiplyScalar(0.5);
      const dist = delhiPos.distanceTo(targetPos);
      mid.normalize().multiplyScalar(R * (1.0 + dist * 0.28));

      const curve = new THREE.QuadraticBezierCurve3(delhiPos, mid, targetPos);
      const points = curve.getPoints(45);
      const arcGeo = new THREE.BufferGeometry().setFromPoints(points);
      const arcMat = new THREE.LineBasicMaterial({
        color: 0xfbbf24,
        transparent: true,
        opacity: 0.5
      });
      const arcLine = new THREE.Line(arcGeo, arcMat);
      globeGroup.add(arcLine);

      // Light Photons Traveling Outward From India
      const pGeo = new THREE.SphereGeometry(0.014, 12, 12);
      const pMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
      const pulse1 = new THREE.Mesh(pGeo, pMat);
      const pulse2 = new THREE.Mesh(pGeo, pMat);
      globeGroup.add(pulse1);
      globeGroup.add(pulse2);

      arcs.push({
        curve,
        pulse1,
        pulse2,
        offset: index * 0.15
      });
    });

    // Initial Camera Position: INDIA IN CENTER
    const initialRotX = 22 * (Math.PI / 180);
    const initialRotY = -(78 + 90) * (Math.PI / 180);

    globeGroup.rotation.x = initialRotX;
    globeGroup.rotation.y = initialRotY;

    let targetRotX = initialRotX;
    let targetRotY = initialRotY;

    let isDragging = false;
    let prevMouseX = 0;
    let prevMouseY = 0;
    let animTime = 0;

    // Animation Render Loop
    function animate() {
      requestAnimationFrame(animate);
      animTime += 0.016;

      // Smooth camera dampening
      globeGroup.rotation.x += (targetRotX - globeGroup.rotation.x) * 0.08;
      globeGroup.rotation.y += (targetRotY - globeGroup.rotation.y) * 0.08;

      // Pulsing Delhi Rings
      const scale = 1 + Math.sin(animTime * 3.5) * 0.5;
      pulseRing.scale.set(scale, scale, scale);
      pulseRingMat.opacity = Math.max(0.15, 0.9 - (scale - 1) * 1.5);

      // Streaming Light Outward from India to Many Cities
      arcs.forEach((arc) => {
        const t1 = (animTime * 0.55 + arc.offset) % 1;
        const t2 = (animTime * 0.55 + arc.offset + 0.5) % 1;
        arc.pulse1.position.copy(arc.curve.getPoint(t1));
        arc.pulse2.position.copy(arc.curve.getPoint(t2));
      });

      // City Name Visibility check (Fade out when city is behind the Earth)
      const worldPos = new THREE.Vector3();
      hubMarkers.forEach(({ mesh, sprite }) => {
        mesh.getWorldPosition(worldPos);
        // If z > 0, the city faces the camera
        const isFacing = worldPos.z > -0.1;
        sprite.visible = isFacing;
        if (isFacing) {
          sprite.material.opacity = Math.min(1, (worldPos.z + 0.2) * 1.5);
        }
      });

      renderer.render(scene, camera);
    }
    animate();

    // Recenter on India Button Action
    recenterBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      targetRotX = initialRotX;
      targetRotY = initialRotY;
    });

    // Raycaster for Hover Tooltip
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      prevMouseX = e.clientX;
      prevMouseY = e.clientY;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) {
        const rect = container.getBoundingClientRect();
        mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(mouse, camera);
        const intersects = raycaster.intersectObjects(hubMarkers.map(h => h.mesh));

        if (intersects.length > 0 && tooltip && tooltipCity && tooltipRole) {
          const hit = hubMarkers.find(h => h.mesh === intersects[0].object);
          if (hit) {
            tooltip.style.opacity = '1';
            tooltip.style.left = `${e.clientX - rect.left + 15}px`;
            tooltip.style.top = `${e.clientY - rect.top - 30}px`;
            tooltipCity.textContent = hit.hub.name;
            tooltipRole.textContent = hit.hub.role;
          }
        } else if (tooltip) {
          tooltip.style.opacity = '0';
        }
        return;
      }

      const dx = e.clientX - prevMouseX;
      const dy = e.clientY - prevMouseY;
      prevMouseX = e.clientX;
      prevMouseY = e.clientY;

      targetRotY += dx * 0.007;
      targetRotX += dy * 0.007;
      targetRotX = Math.max(-1.1, Math.min(1.1, targetRotX));
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    // Touch Support for Mobile
    container.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        prevMouseX = e.touches[0].clientX;
        prevMouseY = e.touches[0].clientY;
      }
    });

    container.addEventListener('touchmove', (e) => {
      if (isDragging && e.touches.length === 1) {
        const dx = e.touches[0].clientX - prevMouseX;
        const dy = e.touches[0].clientY - prevMouseY;
        prevMouseX = e.touches[0].clientX;
        prevMouseY = e.touches[0].clientY;

        targetRotY += dx * 0.009;
        targetRotX += dy * 0.009;
        targetRotX = Math.max(-1.1, Math.min(1.1, targetRotX));
      }
    });

    container.addEventListener('touchend', () => {
      isDragging = false;
    });

    window.addEventListener('resize', () => {
      if (!container) return;
      const newW = container.clientWidth;
      const newH = container.clientHeight;
      camera.aspect = newW / newH;
      camera.updateProjectionMatrix();
      renderer.setSize(newW, newH);
    });
  }

  document.addEventListener('DOMContentLoaded', initRealEarthGlobe);
</script>
