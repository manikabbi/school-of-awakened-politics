---
// src/components/InteractiveGlobe.astro
---

<div class="relative w-full max-w-xl mx-auto flex flex-col items-center select-none">
  <!-- Glowing golden & cosmic aura -->
  <div class="absolute -inset-6 bg-gradient-to-r from-amber-500/30 via-orange-500/20 to-blue-600/25 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header Pill Badge -->
  <div class="mb-3 flex items-center gap-2 rounded-full border border-amber-400/60 bg-slate-950/85 px-4 py-1 text-xs font-semibold tracking-wider text-amber-300 backdrop-blur-md shadow-xl">
    <span class="text-sm">🇮🇳</span>
    <span class="font-cinzel text-amber-200">EPICENTER: BHARAT (INDIA)</span>
    <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-ping"></span>
  </div>

  <!-- 3D Three.js Container -->
  <div class="relative w-[340px] h-[340px] sm:w-[440px] sm:h-[440px] flex items-center justify-center">
    <div 
      id="globe-three-container" 
      class="w-full h-full cursor-grab active:cursor-grabbing rounded-full overflow-hidden shadow-2xl"
    ></div>

    <!-- Overlay Tooltip for Hubs -->
    <div 
      id="globe-tooltip" 
      class="pointer-events-none absolute opacity-0 transition-opacity duration-200 rounded-lg bg-slate-950/95 border border-amber-400 px-3.5 py-2 text-xs text-white shadow-2xl backdrop-blur-md z-30 whitespace-nowrap"
    >
      <div id="tooltip-city" class="font-bold text-amber-300 text-sm flex items-center gap-1.5">New Delhi</div>
      <div id="tooltip-role" class="text-[11px] text-slate-300 font-medium mt-0.5">Centre for Awakened Governance</div>
    </div>

    <!-- Interactive Recenter Floating Control -->
    <button 
      id="recenter-india-btn"
      type="button" 
      class="absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full bg-amber-950/90 hover:bg-amber-900 border border-amber-400/70 px-3 py-1.5 text-[11px] font-bold tracking-wider text-amber-200 backdrop-blur-md shadow-xl transition-all hover:scale-105 active:scale-95 z-20"
      title="Recenter camera on India"
    >
      <span>🎯</span>
      <span>Recenter on India</span>
    </button>
  </div>

  <!-- Made In India For The World - Tagline Banner -->
  <div class="mt-4 flex flex-col items-center gap-1.5 text-center">
    <div class="font-serif italic text-sm text-amber-200 font-medium">
      "From India to the World — Radiating Conscious Statesmanship & Universal Brotherhood"
    </div>
    <div class="flex flex-wrap items-center justify-center gap-4 text-xs text-slate-300 pt-1">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-sm shadow-amber-400/80 ring-2 ring-amber-300/40"></span>
        <span class="font-semibold text-white">Real 3D Earth • India Core</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span>Global Diplomatic Circuits</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="inline-block w-4 h-0.5 bg-gradient-to-r from-amber-400 to-cyan-400"></span>
        <span>Living Policy Arcs</span>
      </div>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  function initReal3DGlobe() {
    const container = document.getElementById('globe-three-container');
    const tooltip = document.getElementById('globe-tooltip');
    const tooltipCity = document.getElementById('tooltip-city');
    const tooltipRole = document.getElementById('tooltip-role');
    const recenterBtn = document.getElementById('recenter-india-btn');
    if (!container) return;

    // Dimensions
    const width = container.clientWidth || 440;
    const height = container.clientHeight || 440;

    // Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 2.75;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.innerHTML = '';
    container.appendChild(renderer.domElement);

    // Earth Sphere Radius
    const R = 1.0;

    // Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.25);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xfff3d6, 1.8);
    dirLight.position.set(3, 2, 4);
    scene.add(dirLight);

    // Root Globe Group for interactive rotation
    const globeGroup = new THREE.Group();
    scene.add(globeGroup);

    // Texture Loader
    const textureLoader = new THREE.TextureLoader();
    const earthTexture = textureLoader.load('/earth-blue-marble.jpg');
    earthTexture.colorSpace = THREE.SRGBColorSpace;

    // Earth Mesh
    const earthGeometry = new THREE.SphereGeometry(R, 64, 64);
    const earthMaterial = new THREE.MeshStandardMaterial({
      map: earthTexture,
      roughness: 0.65,
      metalness: 0.15
    });
    const earthMesh = new THREE.Mesh(earthGeometry, earthMaterial);
    globeGroup.add(earthMesh);

    // Luminous Atmospheric Glow Outer Shell
    const atmosGeometry = new THREE.SphereGeometry(R * 1.03, 48, 48);
    const atmosMaterial = new THREE.MeshBasicMaterial({
      color: 0x38bdf8,
      transparent: true,
      opacity: 0.16,
      side: THREE.BackSide
    });
    const atmosMesh = new THREE.Mesh(atmosGeometry, atmosMaterial);
    scene.add(atmosMesh);

    // Helper: Convert Lat/Lon (degrees) to 3D Cartesian coordinates on sphere
    function latLonToVector3(lat: number, lon: number, radius: number): THREE.Vector3 {
      const phi = (90 - lat) * (Math.PI / 180);
      const theta = (lon + 180) * (Math.PI / 180);
      const x = -radius * Math.sin(phi) * Math.cos(theta);
      const z = radius * Math.sin(phi) * Math.sin(theta);
      const y = radius * Math.cos(phi);
      return new THREE.Vector3(x, y, z);
    }

    // Detailed India Boundary Coordinates
    const indiaPolygon: [number, number][] = [
      [35.5, 74.8], [34.5, 77.5], [32.0, 78.8], [30.5, 80.8], [28.0, 84.0], [27.5, 88.5], 
      [27.0, 92.5], [28.2, 96.5], [26.5, 95.0], [24.5, 93.5], [22.5, 91.8], [21.5, 87.0], 
      [19.0, 85.0], [16.0, 81.0], [13.0, 80.2], [10.0, 79.8], [8.0, 77.5],
      [9.5, 76.2], [12.0, 75.0], [15.5, 73.5], [19.0, 72.8], [21.0, 72.5], [22.5, 69.0],
      [24.5, 68.5], [27.0, 71.0], [30.5, 73.5], [33.0, 74.0], [35.5, 74.8]
    ];

    // Build 3D Golden Boundary Line around India
    const indiaLinePoints: THREE.Vector3[] = [];
    indiaPolygon.forEach(([lat, lon]) => {
      indiaLinePoints.push(latLonToVector3(lat, lon, R * 1.008));
    });
    const indiaLineGeo = new THREE.BufferGeometry().setFromPoints(indiaLinePoints);
    const indiaLineMat = new THREE.LineBasicMaterial({
      color: 0xfbbf24,
      linewidth: 3
    });
    const indiaLine = new THREE.Line(indiaLineGeo, indiaLineMat);
    globeGroup.add(indiaLine);

    // Global Governance Hubs
    const hubs = [
      { name: "New Delhi (SAP Core)", role: "Centre for Awakened Governance & Rajadharma", lat: 28.61, lon: 77.20, isHome: true },
      { name: "Geneva", role: "Multilateral Human Rights & International Law Circuit", lat: 46.20, lon: 6.14, isHome: false },
      { name: "London", role: "Parliamentary Jurisprudence & Commonwealth Circuit", lat: 51.50, lon: -0.12, isHome: false },
      { name: "Singapore", role: "Asian Governance & Innovation Hub", lat: 1.35, lon: 103.81, isHome: false },
      { name: "Nairobi", role: "Global South Environmental & Public Stewardship", lat: -1.29, lon: 36.82, isHome: false },
      { name: "Tokyo", role: "Democratic Technology & Consensus Governance", lat: 35.67, lon: 139.65, isHome: false },
      { name: "Washington D.C.", role: "Global Policy Dialogue & Constitutional Systems", lat: 38.90, lon: -77.03, isHome: false }
    ];

    // Marker Meshes
    const hubMarkers: { mesh: THREE.Mesh; hub: any }[] = [];
    const delhiPos = latLonToVector3(28.61, 77.20, R * 1.012);

    hubs.forEach((hub) => {
      const pos = latLonToVector3(hub.lat, hub.lon, R * 1.012);
      const markerGeo = new THREE.SphereGeometry(hub.isHome ? 0.024 : 0.016, 16, 16);
      const markerMat = new THREE.MeshBasicMaterial({
        color: hub.isHome ? 0xf59e0b : 0x38bdf8
      });
      const marker = new THREE.Mesh(markerGeo, markerMat);
      marker.position.copy(pos);
      globeGroup.add(marker);
      hubMarkers.push({ mesh: marker, hub });
    });

    // Golden Concentric Pulsing Ring on New Delhi
    const pulseRingGeo = new THREE.RingGeometry(0.01, 0.045, 32);
    const pulseRingMat = new THREE.MeshBasicMaterial({
      color: 0xf59e0b,
      side: THREE.DoubleSide,
      transparent: true,
      opacity: 0.8
    });
    const pulseRing = new THREE.Mesh(pulseRingGeo, pulseRingMat);
    pulseRing.position.copy(latLonToVector3(28.61, 77.20, R * 1.014));
    pulseRing.lookAt(delhiPos.clone().multiplyScalar(2));
    globeGroup.add(pulseRing);

    // Radiant Arcs from New Delhi to Global Hubs
    interface ArcData {
      curve: THREE.QuadraticBezierCurve3;
      pulseSphere: THREE.Mesh;
      offset: number;
    }
    const arcs: ArcData[] = [];

    hubs.filter(h => !h.isHome).forEach((target, index) => {
      const targetPos = latLonToVector3(target.lat, target.lon, R * 1.012);
      
      // Calculate elevated midpoint for 3D great circle arc
      const mid = delhiPos.clone().add(targetPos).multiplyScalar(0.5);
      const dist = delhiPos.distanceTo(targetPos);
      mid.normalize().multiplyScalar(R * (1.0 + dist * 0.28));

      const curve = new THREE.QuadraticBezierCurve3(delhiPos, mid, targetPos);
      const points = curve.getPoints(45);
      const arcGeo = new THREE.BufferGeometry().setFromPoints(points);
      const arcMat = new THREE.LineBasicMaterial({
        color: 0xfbbf24,
        transparent: true,
        opacity: 0.45
      });
      const arcLine = new THREE.Line(arcGeo, arcMat);
      globeGroup.add(arcLine);

      // Light Pulse Mesh traveling along the arc
      const pulseGeo = new THREE.SphereGeometry(0.012, 12, 12);
      const pulseMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
      const pulseSphere = new THREE.Mesh(pulseGeo, pulseMat);
      globeGroup.add(pulseSphere);

      arcs.push({
        curve,
        pulseSphere,
        offset: index * 0.2
      });
    });

    // Camera Lock on India:
    // India is at Lat ~22°N, Lon ~78°E.
    // Three.js spherical mapping puts lon=0 at -Z, so rotate globeGroup:
    const initialRotX = 22 * (Math.PI / 180);
    const initialRotY = -(78 + 90) * (Math.PI / 180);

    globeGroup.rotation.x = initialRotX;
    globeGroup.rotation.y = initialRotY;

    let targetRotX = initialRotX;
    let targetRotY = initialRotY;

    // Interaction states
    let isDragging = false;
    let prevMouseX = 0;
    let prevMouseY = 0;
    let animTime = 0;

    // Animation Loop
    function animate() {
      requestAnimationFrame(animate);
      animTime += 0.015;

      // Smooth camera interpolation
      globeGroup.rotation.x += (targetRotX - globeGroup.rotation.x) * 0.08;
      globeGroup.rotation.y += (targetRotY - globeGroup.rotation.y) * 0.08;

      // Pulsing Delhi Ring
      const scale = 1 + Math.sin(animTime * 4) * 0.45;
      pulseRing.scale.set(scale, scale, scale);
      pulseRingMat.opacity = Math.max(0.2, 0.9 - (scale - 1) * 1.5);

      // Animate Arcs Light Pulses Outward from India to Global Hubs
      arcs.forEach((arc) => {
        const t = (animTime * 0.6 + arc.offset) % 1;
        const p = arc.curve.getPoint(t);
        arc.pulseSphere.position.copy(p);
      });

      renderer.render(scene, camera);
    }
    animate();

    // Recenter on India Button Action
    recenterBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      targetRotX = initialRotX;
      targetRotY = initialRotY;
    });

    // Raycaster for Hover Tooltips
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    // Drag & Move Event Listeners
    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      prevMouseX = e.clientX;
      prevMouseY = e.clientY;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) {
        // Tooltip check
        const rect = container.getBoundingClientRect();
        mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(mouse, camera);
        const intersects = raycaster.intersectObjects(hubMarkers.map(h => h.mesh));

        if (intersects.length > 0 && tooltip && tooltipCity && tooltipRole) {
          const hit = hubMarkers.find(h => h.mesh === intersects[0].object);
          if (hit) {
            tooltip.style.opacity = '1';
            tooltip.style.left = `${e.clientX - rect.left + 15}px`;
            tooltip.style.top = `${e.clientY - rect.top - 30}px`;
            tooltipCity.textContent = hit.hub.name;
            tooltipRole.textContent = hit.hub.role;
          }
        } else if (tooltip) {
          tooltip.style.opacity = '0';
        }
        return;
      }

      const dx = e.clientX - prevMouseX;
      const dy = e.clientY - prevMouseY;
      prevMouseX = e.clientX;
      prevMouseY = e.clientY;

      targetRotY += dx * 0.007;
      targetRotX += dy * 0.007;
      targetRotX = Math.max(-1.1, Math.min(1.1, targetRotX));
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    // Touch Support for Mobile
    container.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        prevMouseX = e.touches[0].clientX;
        prevMouseY = e.touches[0].clientY;
      }
    });

    container.addEventListener('touchmove', (e) => {
      if (isDragging && e.touches.length === 1) {
        const dx = e.touches[0].clientX - prevMouseX;
        const dy = e.touches[0].clientY - prevMouseY;
        prevMouseX = e.touches[0].clientX;
        prevMouseY = e.touches[0].clientY;

        targetRotY += dx * 0.009;
        targetRotX += dy * 0.009;
        targetRotX = Math.max(-1.1, Math.min(1.1, targetRotX));
      }
    });

    container.addEventListener('touchend', () => {
      isDragging = false;
    });

    // Handle Window Resize
    window.addEventListener('resize', () => {
      if (!container) return;
      const newW = container.clientWidth;
      const newH = container.clientHeight;
      camera.aspect = newW / newH;
      camera.updateProjectionMatrix();
      renderer.setSize(newW, newH);
    });
  }

  document.addEventListener('DOMContentLoaded', initReal3DGlobe);
</script>
