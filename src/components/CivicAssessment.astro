---
// src/components/CivicAssessment.astro
---

<section id="assessment" class="py-20 lg:py-28 bg-white dark:bg-[#071322] border-b border-stone-200 dark:border-slate-800 relative overflow-hidden transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-block text-xs font-semibold uppercase tracking-widest text-sap-terracotta dark:text-amber-300 bg-amber-50 dark:bg-amber-500/10 px-3.5 py-1 rounded-full border border-amber-200 dark:border-amber-400/30">
        Interactive Civic Diagnostic
      </span>
      <h2 class="mt-3 font-serif text-3xl font-bold text-sap-navy dark:text-white sm:text-4xl">
        What Kind of Civic Leader Are You?
      </h2>
      <p class="mt-2 text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        Discover your authentic public leadership archetype in 60 seconds and identify your customized pathway at SAP.
      </p>
    </div>

    <!-- Quiz Card Container -->
    <div class="max-w-3xl mx-auto rounded-3xl bg-sap-sand dark:bg-[#0e223b] border border-stone-300/80 dark:border-slate-700 p-6 sm:p-10 shadow-xl relative transition-colors">
      <!-- Quiz State (Active Quiz) -->
      <div id="quiz-container">
        <!-- Progress Bar -->
        <div class="mb-8">
          <div class="flex items-center justify-between text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">
            <span id="quiz-step-text">Question 1 of 4</span>
            <span id="quiz-percent-text">25% Complete</span>
          </div>
          <div class="h-2 w-full rounded-full bg-stone-200 dark:bg-slate-700 overflow-hidden">
            <div id="quiz-progress-bar" class="h-full bg-sap-terracotta dark:bg-amber-400 transition-all duration-300" style="width: 25%"></div>
          </div>
        </div>

        <!-- Question Prompt -->
        <h3 id="quiz-question-title" class="font-serif text-xl sm:text-2xl font-bold text-sap-navy dark:text-white mb-6 leading-snug">
          <!-- Dynamically populated -->
        </h3>

        <!-- Options Container -->
        <div id="quiz-options" class="space-y-3.5">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Result State (Hidden Initially) -->
      <div id="result-container" class="hidden text-center space-y-6 py-4">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 dark:bg-amber-500/20 text-3xl shadow-sm mx-auto" id="result-icon">
          🏛️
        </div>

        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-sap-terracotta dark:text-amber-300" id="result-subtitle">
            Your Dominant Leadership Archetype
          </span>
          <h3 class="font-serif text-3xl font-bold text-sap-navy dark:text-white mt-1" id="result-title">
            The Policy Architect
          </h3>
        </div>

        <p class="text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mx-auto" id="result-description">
          <!-- Description text -->
        </p>

        <!-- Strengths & Traps Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left max-w-xl mx-auto border-y border-stone-300 dark:border-slate-700 py-6">
          <div class="rounded-xl bg-white dark:bg-[#162d4a] p-4 border border-stone-200 dark:border-slate-700">
            <div class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 tracking-wider mb-1">Core Strength</div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed" id="result-strength"></p>
          </div>
          <div class="rounded-xl bg-white dark:bg-[#162d4a] p-4 border border-stone-200 dark:border-slate-700">
            <div class="text-xs font-bold uppercase text-amber-700 dark:text-amber-400 tracking-wider mb-1">Recommended SAP Pathway</div>
            <p class="text-xs font-semibold text-slate-800 dark:text-white" id="result-program"></p>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <button
            type="button"
            id="apply-archetype-btn"
            class="trigger-apply-modal w-full sm:w-auto rounded-lg bg-sap-terracotta px-8 py-3 text-sm font-semibold uppercase tracking-wider text-white shadow hover:bg-sap-terracottaDark transition"
          >
            Apply with This Profile →
          </button>
          <button
            type="button"
            id="retake-quiz-btn"
            class="text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white underline transition"
          >
            Retake Diagnostic
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  interface Question {
    text: string;
    options: {
      label: string;
      archetype: 'architect' | 'steward' | 'guardian' | 'consensus' | 'holistic';
    }[];
  }

  const questions: Question[] = [
    {
      text: "A toxic, polarising legislative deadlock has paralyzed public administration. What is your primary leadership instinct?",
      options: [
        { label: "Convene closed-door, respectful dialogue to uncover common human interests beneath partisan posturing.", archetype: "consensus" },
        { label: "Draft a rigorous, data-backed policy amendment with clear impact metrics to break the technical impasse.", archetype: "architect" },
        { label: "Engage directly with affected citizens on the ground to bring lived community realities into the chamber.", archetype: "steward" },
        { label: "Uphold constitutional standards and rule of law impartially without capitulating to political coercion.", archetype: "guardian" },
        { label: "Synthesize all four: ground the issue in citizen truth, address systemic policy flaws, and broker ethical consensus.", archetype: "holistic" }
      ]
    },
    {
      text: "All of the following are catastrophic failures in contemporary politics. Which systemic crisis does your conscience compel you to confront first?",
      options: [
        { label: "The collapse of empathetic dialogue, deep social polarization, and the dehumanization of political opponents.", archetype: "consensus" },
        { label: "Incompetent, reactionary legislation detached from economic realities and evidence-based science.", archetype: "architect" },
        { label: "The abandonment and exploitation of ordinary working families by self-serving, insulated elites.", archetype: "steward" },
        { label: "The decay of independent institutions, corruption of ethics, and loss of constitutional morality.", archetype: "guardian" },
        { label: "All of the above — they are deeply interconnected symptoms of a broken, unawakened political culture.", archetype: "holistic" }
      ]
    },
    {
      text: "In an authentic leadership curriculum, which mastery area do you consider most essential for transforming public life?",
      options: [
        { label: "Depolarizing mediation, emotional intelligence, and bridging fractured ideological factions.", archetype: "consensus" },
        { label: "Parliamentary bill drafting, budgetary scrutiny, and systemic policy architecture.", archetype: "architect" },
        { label: "Grassroots organizing, lived community listening, and public service mobilization.", archetype: "steward" },
        { label: "Ethical courage under extreme pressure, constitutional law, and anti-corruption frameworks.", archetype: "guardian" },
        { label: "The complete synthesis: inner self-mastery (Viveka) directly integrated with institutional governance craft.", archetype: "holistic" }
      ]
    },
    {
      text: "What lasting legacy do you aspire to build through your public life?",
      options: [
        { label: "Healing deep societal wounds and fostering a culture of mutual trust and civic brotherhood.", archetype: "consensus" },
        { label: "Enduring legislative frameworks and public institutions that function seamlessly for generations.", archetype: "architect" },
        { label: "Empowered communities whose dignity and voice are permanently enshrined in governance.", archetype: "steward" },
        { label: "Restoring inviolable moral reverence, justice, and unyielding integrity to the Republic.", archetype: "guardian" },
        { label: "Igniting a civilisational renaissance of awakened statesmanship that inspires the world.", archetype: "holistic" }
      ]
    }
  ];

  const archetypes = {
    holistic: {
      title: "The Awakened Statesperson",
      subtitle: "Integrated Systems & Moral Statesmanship",
      icon: "🌟",
      description: "You recognize that political decay cannot be solved with piecemeal fixes. Institutional erosion, policy incompetence, grassroots alienation, and bitter polarization are interconnected fruits of an unawakened political culture. You are called to holistic leadership that unites inner integrity with nationwide institutional renewal.",
      strength: "360° systemic vision, moral synthesis, bridging inner self-mastery with rigorous public stewardship.",
      program: "SAP World Leaders Fellowship (Comprehensive Track)"
    },
    architect: {
      title: "The Policy Architect",
      subtitle: "Systemic Thinker & Institutional Designer",
      icon: "📐",
      description: "You believe that high ideals without structural competence are empty. You excel at translating complex societal challenges into rigorous, sustainable legislative and economic frameworks.",
      strength: "Evidence-driven strategy, legislative drafting precision, and long-term systemic foresight.",
      program: "SAP World Leaders Fellowship & Policy Research Lab"
    },
    steward: {
      title: "The Grassroots Steward",
      subtitle: "Community Centered & Empathy Driven",
      icon: "🌱",
      description: "You are the living heartbeat of authentic democracy. You lead from the ground up, refusing to let bureaucratic corridors disconnect you from the lived pain and hopes of citizens.",
      strength: "Deep listening, community trust cultivation, and relentless frontline advocacy.",
      program: "Governance Circuits & SAP World Leaders Fellowship"
    },
    guardian: {
      title: "The Institutional Guardian",
      subtitle: "Constitutional Morality & Ethical Bulwark",
      icon: "⚖️",
      description: "You are the moral anchor of the Republic. You possess the unbending courage to defend constitutional principles, institutional independence, and ethical justice against populism and corruption.",
      strength: "Inviolable ethical clarity, constitutional jurisprudence, and moral courage under pressure.",
      program: "SAP World Leaders Fellowship & Leadership Retreats"
    },
    consensus: {
      title: "The Consensus Builder",
      subtitle: "Bridge Builder & Deliberative Statesperson",
      icon: "🕊️",
      description: "You see beyond partisan battlefields to recognize common human dignity. You possess the emotional mastery to dissolve vitriol, build multi-stakeholder coalitions, and birth united solutions.",
      strength: "Non-violent communication, conflict resolution, and cross-party consensus creation.",
      program: "Conscious Parliament Circles & Leadership Retreats"
    }
  };

  function initQuiz() {
    let currentStep = 0;
    const scores = { architect: 0, steward: 0, guardian: 0, consensus: 0, holistic: 0 };

    const quizContainer = document.getElementById('quiz-container');
    const resultContainer = document.getElementById('result-container');
    const stepText = document.getElementById('quiz-step-text');
    const percentText = document.getElementById('quiz-percent-text');
    const progressBar = document.getElementById('quiz-progress-bar');
    const questionTitle = document.getElementById('quiz-question-title');
    const optionsContainer = document.getElementById('quiz-options');
    const retakeBtn = document.getElementById('retake-quiz-btn');

    if (!quizContainer || !questionTitle || !optionsContainer) return;

    function renderQuestion(index: number) {
      const q = questions[index];
      if (stepText) stepText.textContent = `Question ${index + 1} of ${questions.length}`;
      if (percentText) percentText.textContent = `${Math.round(((index + 1) / questions.length) * 100)}% Complete`;
      if (progressBar) progressBar.style.width = `${((index + 1) / questions.length) * 100}%`;
      questionTitle.textContent = q.text;

      optionsContainer.innerHTML = '';
      q.options.forEach((opt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'w-full text-left p-4 rounded-xl border border-stone-200 dark:border-slate-700 bg-white dark:bg-[#162d4a] hover:border-sap-terracotta dark:hover:border-amber-400 hover:bg-amber-50/50 dark:hover:bg-[#1f3a5f] hover:shadow-sm transition flex items-start gap-3.5 group';
        btn.innerHTML = `
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-stone-300 dark:border-slate-500 text-xs font-semibold text-slate-500 dark:text-slate-300 group-hover:border-sap-terracotta group-hover:bg-sap-terracotta group-hover:text-white transition">
            •
          </span>
          <span class="text-xs sm:text-sm text-slate-700 dark:text-slate-200 group-hover:text-slate-900 dark:group-hover:text-white leading-relaxed font-medium">
            ${opt.label}
          </span>
        `;
        btn.addEventListener('click', () => {
          scores[opt.archetype]++;
          if (currentStep < questions.length - 1) {
            currentStep++;
            renderQuestion(currentStep);
          } else {
            showResults();
          }
        });
        optionsContainer.appendChild(btn);
      });
    }

    function showResults() {
      if (!quizContainer || !resultContainer) return;
      quizContainer.classList.add('hidden');
      resultContainer.classList.remove('hidden');

      // Find highest scoring archetype (bias towards holistic if chosen)
      let topKey: 'architect' | 'steward' | 'guardian' | 'consensus' | 'holistic' = 'holistic';
      let maxScore = -1;
      for (const [key, val] of Object.entries(scores)) {
        if (val > maxScore) {
          maxScore = val;
          topKey = key as any;
        }
      }

      const res = archetypes[topKey];
      try {
        localStorage.setItem('sap_last_archetype', JSON.stringify({
          key: topKey,
          title: res.title,
          program: res.program
        }));
      } catch (e) {}

      const resultIcon = document.getElementById('result-icon');
      const resultSubtitle = document.getElementById('result-subtitle');
      const resultTitle = document.getElementById('result-title');
      const resultDesc = document.getElementById('result-description');
      const resultStrength = document.getElementById('result-strength');
      const resultProgram = document.getElementById('result-program');

      if (resultIcon) resultIcon.textContent = res.icon;
      if (resultSubtitle) resultSubtitle.textContent = res.subtitle;
      if (resultTitle) resultTitle.textContent = res.title;
      if (resultDesc) resultDesc.textContent = res.description;
      if (resultStrength) resultStrength.textContent = res.strength;
      if (resultProgram) resultProgram.textContent = res.program;
    }

    retakeBtn?.addEventListener('click', () => {
      currentStep = 0;
      scores.architect = 0;
      scores.steward = 0;
      scores.guardian = 0;
      scores.consensus = 0;
      scores.holistic = 0;
      quizContainer?.classList.remove('hidden');
      resultContainer?.classList.add('hidden');
      renderQuestion(0);
    });

    renderQuestion(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initQuiz);
  } else {
    initQuiz();
  }
</script>
