---
// src/layouts/BaseLayout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ApplicationModal from '../components/ApplicationModal.astro';
import PadmaAIAgent from '../components/PadmaAIAgent.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "School of Awakened Politics (SAP) | Lead from Your Authentic Self",
  description = "Centre for Excellence in Leadership and Governance. Cultivating conscious, purpose-driven political leaders through authentic stewardship, empathy, and systemic training.",
  image = "https://schoolofawakenedpolitics.org/og-card.jpg?v=5"
} = Astro.props;

// Format canonical URL ensuring trailing slash matches Astro static site generation
const rawPath = Astro.url.pathname;
const cleanPath = (rawPath === '/' || rawPath.endsWith('/') || rawPath.includes('.'))
  ? rawPath
  : `${rawPath}/`;
const canonicalUrl = new URL(cleanPath, "https://schoolofawakenedpolitics.org").href;
const currentPath = Astro.url.pathname;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": "https://schoolofawakenedpolitics.org/#organization",
      "name": "School of Awakened Politics",
      "alternateName": [
        "SAP",
        "School of Awakened Politics (SAP)",
        "School of Awakened Politics India"
      ],
      "url": "https://schoolofawakenedpolitics.org/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://schoolofawakenedpolitics.org/logo.svg",
        "width": "512",
        "height": "512"
      },
      "image": "https://schoolofawakenedpolitics.org/og-card.jpg?v=4",
      "description": "Centre for Excellence in Leadership and Governance. Inspiring conscious, purpose-driven political leaders through authentic stewardship, empathy, and systemic training.",
      "foundingDate": "2026",
      "slogan": "Lead From Your Authentic Self",
      "areaServed": "Global",
      "parentOrganization": {
        "@type": "Organization",
        "name": "Find Your Uniqueness",
        "url": "https://www.findyouruniqueness.org"
      },
      "knowsAbout": [
        "Political Leadership",
        "Conscious Politics",
        "Public Policy Fellowship",
        "Governance and Statecraft",
        "Ethical Leadership",
        "Democratic Institutions"
      ],
      "sameAs": [
        "https://www.findyouruniqueness.org"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Admissions & Inquiries",
        "url": "https://schoolofawakenedpolitics.org/contact/"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://schoolofawakenedpolitics.org/#website",
      "url": "https://schoolofawakenedpolitics.org/",
      "name": "School of Awakened Politics",
      "description": "Centre for Excellence in Leadership and Governance. Inspiring conscious, purpose-driven political leaders.",
      "publisher": {
        "@id": "https://schoolofawakenedpolitics.org/#organization"
      },
      "inLanguage": "en-US"
    }
  ]
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="School of Awakened Politics, school of awakened politics, schoolofawakenedpolitics.org, SAP politics, political school India, conscious politics, ethical political leadership, governance fellowship India, political fellowship, public policy fellowship, Find Your Uniqueness, authentic leadership" />
    <meta name="author" content="School of Awakened Politics" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="revisit-after" content="2 days" />
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="India" />
    <meta name="google-site-verification" content="3AtpGwwlWZszHVvtmq5kXgEWNxkfOKwnZSyDEc52Ehc" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="School of Awakened Politics" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Theme Initializer: Runs before render to prevent flash -->
    <script is:inline>
      const savedTheme = localStorage.getItem('sap-theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-sap-sand text-slate-800 dark:bg-sap-navy dark:text-slate-100 transition-colors duration-200">
    <Navbar currentPath={currentPath} />
    
    <main class="flex-1">
      <slot />
    </main>

    <Footer />
    <ApplicationModal />
    <PadmaAIAgent />
  </body>
</html>
