---
// src/pages/blogs.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = [
  {
    title: "Why Leadership Preformation Must Precede Electoral Politics",
    category: "Manifesto & Theory",
    date: "October 2026",
    excerpt: "Reforming political systems procedurally without transforming the human consciousness of the leaders will only reproduce corruption under newer legal banners.",
    readTime: "7 min read"
  },
  {
    title: "The Lost Art of Deliberation: Why Multiparty Democracies Need Empathy",
    category: "Governance & Ethics",
    date: "September 2026",
    excerpt: "When politics becomes an algorithmic popularity game, empathy is dismissed as weakness. Yet without empathy, laws cannot heal systemic societal wounds.",
    readTime: "5 min read"
  },
  {
    title: "Rajadharma in the 21st Century: Ancient Insights for Modern Statecraft",
    category: "Civilisational Thought",
    date: "August 2026",
    excerpt: "How Indian civilisational philosophy articulated public duty as a sacred trust (Lokasamgraha) rather than personal entitlement or factional triumph.",
    readTime: "9 min read"
  }
];
---

<BaseLayout
  title="Publishing Platform | School of Awakened Politics"
  description="Bold, ethical, and transformative policy ideas and civilisational thought shaping public discourse."
>
  <!-- Page Header -->
  <section class="bg-sap-navy text-white py-20 border-b border-stone-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block text-xs font-semibold uppercase tracking-widest text-amber-300 bg-white/10 px-3.5 py-1 rounded-full">
          Publishing Platform
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold leading-tight">
          Essays, Research & Public Discourse
        </h1>
        <p class="font-cinzel text-base text-amber-200">
          Shaping Ideas for Conscious Leadership & Systemic Governance
        </p>
      </div>
    </div>
  </section>

  <!-- Editorial Section -->
  <section class="py-12 sm:py-16 bg-white dark:bg-[#071322] transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Call for Papers & Essays Banner -->
      <div class="rounded-2xl border border-amber-300/50 dark:border-amber-400/30 bg-gradient-to-r from-amber-50 via-white to-amber-50 dark:from-[#0e223d] dark:via-[#122845] dark:to-[#0e223d] p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-sm">
        <div class="space-y-2 max-w-2xl">
          <div class="flex items-center gap-2.5">
            <span class="text-amber-600 dark:text-amber-400 text-lg">📝</span>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-sap-navy dark:text-white">Call for Papers & Essays</h3>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            We welcome original contributions from scholars, active civil servants, and civic practitioners on ethical governance, depolarizing communication, and institutional reform.
          </p>
        </div>
        <a
          href="mailto:info@schoolofawakenedpolitics.org?subject=Publishing%20Submission"
          class="shrink-0 inline-flex items-center gap-2 rounded-lg bg-sap-terracotta hover:bg-sap-terracottaDark px-6 py-3 text-xs font-semibold uppercase tracking-wider text-white shadow-md hover:shadow-lg transition-all"
        >
          Submit an Article Proposal
          <span class="text-sm">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-8 space-y-10">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-sap-navy dark:text-white border-b border-stone-200 dark:border-slate-800 pb-4">
            Featured Perspectives
          </h2>

          <div class="space-y-8">
            {articles.map((item) => (
              <article class="group rounded-2xl border border-stone-200 dark:border-slate-700 bg-sap-sand dark:bg-[#0e223d] p-8 transition hover:border-sap-terracotta dark:hover:border-amber-400 hover:shadow-md">
                <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wider text-sap-terracotta dark:text-amber-300 mb-2">
                  <span>{item.category}</span>
                  <span>•</span>
                  <span class="text-slate-500 dark:text-slate-400">{item.date}</span>
                  <span>•</span>
                  <span class="text-slate-500 dark:text-slate-400">{item.readTime}</span>
                </div>

                <h3 class="font-serif text-2xl font-bold text-sap-navy dark:text-white group-hover:text-sap-terracotta dark:group-hover:text-amber-300 transition">
                  <a href="#">{item.title}</a>
                </h3>

                <p class="mt-3 text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                  {item.excerpt}
                </p>

                <div class="mt-4 pt-4 border-t border-stone-200/60 dark:border-slate-700/80 flex items-center justify-between text-xs font-semibold">
                  <span class="text-sap-navy dark:text-amber-300 group-hover:text-sap-terracotta transition">Read Full Article →</span>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-4 space-y-6">
          <div class="rounded-2xl bg-sap-navy dark:bg-[#122845] p-6 text-white space-y-4 border border-transparent dark:border-slate-700">
            <h4 class="font-serif text-lg font-bold">Subscribe to the SAP Gazette</h4>
            <p class="text-xs text-slate-300">
              Receive monthly essays, fellowship announcements, and policy briefings directly in your inbox.
            </p>
            <form id="gazette-newsletter-form" class="space-y-3">
              <input
                id="newsletter-email"
                type="email"
                name="email"
                required
                placeholder="Your email address"
                class="w-full rounded-lg border border-slate-600 bg-white/10 px-3 py-2 text-xs text-white placeholder-slate-400 focus:border-amber-400 focus:outline-none"
              />
              <div id="newsletter-feedback" class="hidden text-xs font-medium text-amber-300"></div>
              <button
                id="newsletter-submit-btn"
                type="submit"
                class="w-full rounded-lg bg-sap-terracotta py-2 text-xs font-semibold uppercase tracking-wider text-white hover:bg-sap-terracottaDark transition"
              >
                Subscribe
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('gazette-newsletter-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
    const feedback = document.getElementById('newsletter-feedback');
    const submitBtn = document.getElementById('newsletter-submit-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim() || '';
      if (!email) return;

      if (submitBtn) submitBtn.textContent = 'Subscribing...';

      // 1. Webhook dispatch
      const sheetUrl = localStorage.getItem('sap_sheets_webhook_url');
      if (sheetUrl && sheetUrl.startsWith('http')) {
        fetch(sheetUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            formType: 'newsletter',
            email: email
          })
        }).catch(() => {});
      }

      // 2. Email notify
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          access_key: '5b1dc854-c8c8-4ce6-a797-ea6541f92e7b',
          subject: `New SAP Gazette Subscriber: ${email}`,
          from_name: 'SAP Publishing Portal',
          email: email
        })
      }).catch(() => {});

      if (feedback) {
        feedback.classList.remove('hidden');
        feedback.textContent = '✓ You are subscribed to the SAP Gazette!';
      }
      form.reset();
      if (submitBtn) submitBtn.textContent = 'Subscribed ✓';
      setTimeout(() => {
        if (submitBtn) submitBtn.textContent = 'Subscribe';
      }, 3000);
    });
  </script>
</BaseLayout>
