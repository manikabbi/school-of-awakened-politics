---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | School of Awakened Politics"
  description="Connect with the School of Awakened Politics for admissions, fellowship inquiries, research collaborations, and institutional dialogues."
>
  <!-- Page Header -->
  <section class="bg-sap-navy text-white py-20 border-b border-stone-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block text-xs font-semibold uppercase tracking-widest text-amber-300 bg-white/10 px-3.5 py-1 rounded-full">
          Get in Touch
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold leading-tight">
          Connect with the School of Awakened Politics
        </h1>
        <p class="font-cinzel text-base text-amber-200">
          Reach Out to Start Your Leadership Journey
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Grid -->
  <section class="py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Contact Form -->
        <div class="lg:col-span-7 rounded-3xl border border-stone-200 bg-sap-sand p-8 sm:p-12 shadow-sm">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-sap-navy mb-2">
            Send an Inquiry
          </h2>
          <p class="text-sm text-slate-600 mb-8">
            Whether you are an aspiring candidate, an educational institution, or an administrator seeking collaboration, we welcome your message.
          </p>

          <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for reaching out! Your message has been sent to info@schoolofawakenedpolitics.org'); this.reset();">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Full Name *</label>
                <input 
                  type="text" 
                  required 
                  placeholder="e.g. Priyanshu Varma"
                  class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-sap-terracotta focus:outline-none focus:ring-1 focus:ring-sap-terracotta"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Email Address *</label>
                <input 
                  type="email" 
                  required 
                  placeholder="priyanshu@example.com"
                  class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-sap-terracotta focus:outline-none focus:ring-1 focus:ring-sap-terracotta"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Phone / WhatsApp</label>
                <input 
                  type="tel" 
                  placeholder="+91 98765 43210"
                  class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-sap-terracotta focus:outline-none focus:ring-1 focus:ring-sap-terracotta"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Subject / Category</label>
                <select class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:border-sap-terracotta focus:outline-none focus:ring-1 focus:ring-sap-terracotta">
                  <option value="fellowship">Fellowship Admissions</option>
                  <option value="partnership">Institutional Partnership</option>
                  <option value="research">Policy Lab Collaboration</option>
                  <option value="retreats">Leadership Retreat Inquiries</option>
                  <option value="general">General Inquiries</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Your Message *</label>
              <textarea 
                rows="4" 
                required 
                placeholder="How can we assist your journey in public leadership?"
                class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-sap-terracotta focus:outline-none focus:ring-1 focus:ring-sap-terracotta"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full rounded-lg bg-sap-terracotta py-3.5 text-sm font-semibold uppercase tracking-wider text-white shadow hover:bg-sap-terracottaDark transition"
            >
              Send Message
            </button>
          </form>
        </div>

        <!-- Contact Information & Channels -->
        <div class="lg:col-span-5 space-y-8">
          <div class="rounded-3xl border border-stone-200 bg-sap-sand p-8 space-y-6">
            <h3 class="font-serif text-xl font-bold text-sap-navy">Direct Communication</h3>
            
            <div class="space-y-4 text-sm">
              <div class="flex items-start gap-3">
                <span class="text-xl">✉️</span>
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Official Email</div>
                  <a href="mailto:info@schoolofawakenedpolitics.org" class="font-medium text-sap-navy hover:text-sap-terracotta underline">
                    info@schoolofawakenedpolitics.org
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-xl">🌐</span>
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Official Website</div>
                  <span class="font-medium text-slate-700">schoolofawakenedpolitics.org</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-xl">💬</span>
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Connected Channels</div>
                  <p class="text-slate-600 text-xs mt-1">
                    You can contact our team via E-mail, WhatsApp, Instagram, Twitter/X, & Facebook.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Frequently Asked Questions -->
          <div class="rounded-3xl bg-sap-navy p-8 text-white space-y-4">
            <h3 class="font-serif text-lg font-bold">Frequently Asked Questions</h3>
            
            <div class="space-y-3 text-xs text-slate-200 leading-relaxed">
              <div>
                <strong class="text-amber-300 block mb-0.5">Are programs open to beginners?</strong>
                Yes. No prior election or political experience is required. We evaluate moral clarity and commitment to service.
              </div>
              <div class="border-t border-slate-700 pt-3">
                <strong class="text-amber-300 block mb-0.5">Can working professionals participate?</strong>
                Yes. All core fellowship cohorts follow a hybrid executive format with weekend modules and designated immersion circuits.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
