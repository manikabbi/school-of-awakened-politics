---
// src/pages/fellowship.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import FellowshipCurriculumExplorer from '../components/FellowshipCurriculumExplorer.astro';
---

<BaseLayout
  title="SAP World Leaders Fellowship Program | School of Awakened Politics"
  description="An intensive leadership journey cultivating conscious, purpose-driven political leaders through inner transformation and real-world governance exposure."
>
  <!-- Hero Section -->
  <section class="bg-sap-navy text-white py-20 lg:py-28 relative overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-500/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-widest text-amber-300">
          🌟 Flagship Leadership Program
        </div>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight">
          SAP World Leaders <br />
          <span class="text-amber-300">Fellowship Program</span>
        </h1>
        <p class="font-cinzel text-lg text-amber-200">
          Cultivating Conscious, Purpose-Driven Political Leaders
        </p>
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed max-w-2xl">
          An intensive, transformative fellowship designed for emerging leaders who seek to reform public life from the inside out. Integrating rigorous political literacy, deep self-mastery, and authentic governance exposure.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <button
            type="button"
            class="trigger-apply-modal rounded-lg bg-sap-terracotta px-8 py-3.5 text-sm font-semibold uppercase tracking-wider text-white shadow hover:bg-sap-terracottaDark transition"
          >
            Apply for Fellowship
          </button>
          <a
            href="#curriculum"
            class="rounded-lg border border-white/20 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white hover:bg-white/20 transition"
          >
            Explore Curriculum ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Fellowship Metrics -->
  <section class="border-y border-stone-200 dark:border-slate-800 bg-sap-sand dark:bg-[#071322] py-8 transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="font-serif text-3xl font-bold text-sap-navy dark:text-amber-300">1 Year</div>
          <div class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 mt-1">Duration (12 Months Hybrid)</div>
        </div>
        <div>
          <div class="font-serif text-3xl font-bold text-sap-navy dark:text-amber-300">4 Terms</div>
          <div class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 mt-1">12 In-Depth Modules</div>
        </div>
        <div>
          <div class="font-serif text-3xl font-bold text-sap-navy dark:text-amber-300">4 Immersions</div>
          <div class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 mt-1">Residential & Field Circuits</div>
        </div>
        <div>
          <div class="font-serif text-3xl font-bold text-sap-navy dark:text-amber-300">30 Fellows</div>
          <div class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 mt-1">Selected Annual Cohort</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Curriculum Section -->
  <section id="curriculum" class="py-20 bg-white dark:bg-[#0b192c] transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-semibold uppercase tracking-widest text-sap-terracotta dark:text-amber-300 bg-amber-50 dark:bg-amber-500/10 px-3.5 py-1 rounded-full border border-amber-200 dark:border-amber-400/30">
          Comprehensive Syllabus
        </span>
        <h2 class="mt-3 font-serif text-3xl font-bold text-sap-navy dark:text-white sm:text-4xl">
          Four Academic Terms of the 1-Year Journey
        </h2>
        <p class="mt-2 text-slate-600 dark:text-slate-300 text-sm sm:text-base">
          A holistically balanced pedagogy combining inward clarity, grassroots ground reality, advanced policy & AI science, and ethical statesmanship.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Term 1 -->
        <div class="rounded-2xl border border-stone-200 dark:border-slate-700 bg-sap-sand dark:bg-[#0e223d] p-8 hover:shadow-md transition">
          <div class="flex items-center gap-3 mb-4">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-sap-terracotta text-white font-bold">1</span>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-sap-terracotta dark:text-amber-400">Months 01–03</span>
              <h3 class="font-serif text-xl font-bold text-sap-navy dark:text-white">Inner Mastery & Constitutional Foundations</h3>
            </div>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Grounded in self-inquiry and emotional discernment (Viveka). Fellows deconstruct the psychology of power and ego, anchor in Rajadharma ethics, and study constitutional jurisprudence and checks & balances.
          </p>
          <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-2 border-t border-stone-200 dark:border-slate-700/80 pt-3">
            <li>• Psychology of Power & Moral Courage Under Political Scrutiny</li>
            <li>• Constitutional Morality, Landmark Jurisprudence & Separation of Powers</li>
            <li>• Comparative Statecraft: Kautilya, Ashoka, Gandhi, Ambedkar & Rawls</li>
          </ul>
        </div>

        <!-- Term 2 -->
        <div class="rounded-2xl border border-stone-200 dark:border-slate-700 bg-sap-sand dark:bg-[#0e223d] p-8 hover:shadow-md transition">
          <div class="flex items-center gap-3 mb-4">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-sap-navy dark:bg-amber-600 text-white font-bold">2</span>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-sap-terracotta dark:text-amber-400">Months 04–06</span>
              <h3 class="font-serif text-xl font-bold text-sap-navy dark:text-white">Grassroots Realities, Cities & Public Finance</h3>
            </div>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Direct immersion in rural Panchayati Raj governance, urban municipal systems (74th Amendment), municipal debt, state treasury deconstruction, GST dynamics, and forensic public budgeting.
          </p>
          <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-2 border-t border-stone-200 dark:border-slate-700/80 pt-3">
            <li>• 10-Day Village Gram Sabha Immersion & Rural Agrarian Systems</li>
            <li>• Urban Municipal Governance, Ward Committees & Climate Infrastructure</li>
            <li>• Public Finance, State Budgeting & Forensic Line-Item Analysis</li>
          </ul>
        </div>

        <!-- Term 3 -->
        <div class="rounded-2xl border border-stone-200 dark:border-slate-700 bg-sap-sand dark:bg-[#0e223d] p-8 hover:shadow-md transition">
          <div class="flex items-center gap-3 mb-4">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-sap-terracotta text-white font-bold">3</span>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-sap-terracotta dark:text-amber-400">Months 07–09</span>
              <h3 class="font-serif text-xl font-bold text-sap-navy dark:text-white">Policy Research Lab, AI Ethics & Deliberation</h3>
            </div>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Direct hands-on drafting of statutory bills, regulatory impact assessment, exploration of frontier AI safety and digital public infrastructure, and mastering non-adversarial Conscious Parliament Circles.
          </p>
          <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-2 border-t border-stone-200 dark:border-slate-700/80 pt-3">
            <li>• Statutory Bill Drafting Grammar & Evidence-Based Policy Modeling</li>
            <li>• Frontier AI Governance, Data Sovereignty & Climate Geopolitics</li>
            <li>• Conscious Parliament Circles: Depolarization & Cross-Party Accords</li>
          </ul>
        </div>

        <!-- Term 4 -->
        <div class="rounded-2xl border border-stone-200 dark:border-slate-700 bg-sap-sand dark:bg-[#0e223d] p-8 hover:shadow-md transition">
          <div class="flex items-center gap-3 mb-4">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-sap-navy dark:bg-amber-600 text-white font-bold">4</span>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-sap-terracotta dark:text-amber-400">Months 10–12</span>
              <h3 class="font-serif text-xl font-bold text-sap-navy dark:text-white">Clean Campaigns, Crisis Leadership & Capstone</h3>
            </div>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Mastering clean campaign finance, grassroots electoral organizing, national security and crisis war-room simulations, concluding with the public defense of a 1-year transformation capstone.
          </p>
          <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-2 border-t border-stone-200 dark:border-slate-700/80 pt-3">
            <li>• Representation of the People Act, Grassroots Mobilization & Clean Finance</li>
            <li>• Strategic Crisis War-Room Simulation & Diplomatic Geostrategy</li>
            <li>• Public Defense of 1-Year Capstone Initiative & Statesmanship Convocation</li>
          </ul>
        </div>
      </div>

      <!-- 1-Year Interactive Timeline Architecture -->
      <div class="mt-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-semibold uppercase tracking-widest text-sap-terracotta dark:text-amber-300 bg-amber-50 dark:bg-amber-500/10 px-3.5 py-1 rounded-full border border-amber-200 dark:border-amber-400/30">
            Chronological Journey
          </span>
          <h3 class="mt-2 font-serif text-3xl font-bold text-sap-navy dark:text-white">
            1-Year Fellowship Cohort Timeline (12 Months)
          </h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300 text-sm">
            Select any month or academic term below to explore the detailed modules, field circuits, mentor dialogues, and deliverables.
          </p>
        </div>

        <FellowshipCurriculumExplorer />
      </div>
    </div>
  </section>

  <!-- Application CTA Section -->
  <section class="py-20 bg-sap-sand dark:bg-[#071322] border-t border-stone-200 dark:border-slate-800 text-center transition-colors duration-200">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6">
      <span class="text-xs font-semibold uppercase tracking-widest text-sap-terracotta dark:text-amber-300 bg-amber-100 dark:bg-amber-500/20 px-3.5 py-1 rounded-full">
        Admissions Open
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-sap-navy dark:text-white">
        Are You Ready to Lead from Authenticity?
      </h2>
      <p class="text-slate-600 dark:text-slate-300 text-base max-w-2xl mx-auto leading-relaxed">
        Admissions for the upcoming cohort are rolling. We evaluate applications based on ethical commitment, social concern, and readiness to engage in deep personal transformation.
      </p>
      <div class="pt-4">
        <button
          type="button"
          class="trigger-apply-modal rounded-lg bg-sap-terracotta px-8 py-3.5 text-sm font-semibold uppercase tracking-wider text-white shadow hover:bg-sap-terracottaDark transition"
        >
          Submit Fellowship Application
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
