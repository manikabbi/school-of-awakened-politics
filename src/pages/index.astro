---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GlobalCircuitsSection from '../components/GlobalCircuitsSection.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import ProgramsGrid from '../components/ProgramsGrid.astro';
import CivicAssessment from '../components/CivicAssessment.astro';
import FellowshipCurriculumExplorer from '../components/FellowshipCurriculumExplorer.astro';
---

<BaseLayout
  title="School of Awakened Politics (SAP) | Lead from Your Authentic Self"
  description="Centre for Excellence in Leadership and Governance. Inspiring conscious, purpose-driven political leaders through authentic stewardship, empathy, and systemic training."
>
  <!-- Hero Section with Highlighted Parliament Model Architecture -->
  <Hero />

  <!-- Downside of First Page: Global Leadership Circuits & Prominent 3D Globe with Outward Radiation -->
  <GlobalCircuitsSection />

  <!-- Foundational Philosophy & Academic Stance -->
  <PhilosophySection />

  <!-- Interactive 3D Programs Grid -->
  <ProgramsGrid />

  <!-- Interactive Civic Leader Diagnostic Tool (Quiz) -->
  <CivicAssessment />

  <!-- 6-Month Fellowship Interactive Curriculum Architecture -->
  <section class="py-20 bg-sap-sand dark:bg-[#071322] border-b border-stone-200 dark:border-slate-800 transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block text-xs font-semibold uppercase tracking-widest text-sap-terracotta dark:text-amber-300 bg-amber-100/60 dark:bg-amber-500/10 px-3.5 py-1 rounded-full border border-amber-300 dark:border-amber-400/30">
          The Learning Arc
        </span>
        <h2 class="mt-3 font-serif text-3xl font-bold text-sap-navy dark:text-white sm:text-4xl">
          Inside the Fellowship Experience
        </h2>
        <p class="mt-2 text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
          Explore the immersive 6-month journey that transforms high-potential citizens into grounded statespeople.
        </p>
      </div>

      <FellowshipCurriculumExplorer />
    </div>
  </section>

  <!-- Inclusivity, Audience & Eligibility Section -->
  <section class="py-20 bg-white dark:bg-[#0b192c] border-t border-stone-200 dark:border-slate-800 transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-semibold uppercase tracking-widest text-sap-terracotta dark:text-amber-300 bg-amber-50 dark:bg-amber-500/10 px-3.5 py-1 rounded-full border border-amber-200 dark:border-amber-400/30">
            Inclusivity & Calling
          </span>
          <h2 class="font-serif text-3xl font-bold text-sap-navy dark:text-white sm:text-4xl leading-tight">
            Who Can Join the Movement?
          </h2>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-base">
            Awakened politics is not reserved for dynastic elites or career politicians. It is a sacred calling open to all citizens who desire to see their communities thrive with justice, clarity, and dignity.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-100 dark:bg-amber-500/20 text-sap-terracotta dark:text-amber-300 font-bold text-sm">
                1
              </div>
              <div>
                <h4 class="font-serif text-base font-bold text-sap-navy dark:text-white">Youth & College Students</h4>
                <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">Cultivate constitutional literacy, ethical courage, and statesmanship before entering the public arena.</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-100 dark:bg-amber-500/20 text-sap-terracotta dark:text-amber-300 font-bold text-sm">
                2
              </div>
              <div>
                <h4 class="font-serif text-base font-bold text-sap-navy dark:text-white">Working Professionals & Civil Society</h4>
                <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">Apply your strategic expertise in law, technology, policy, and enterprise toward systemic governance.</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-100 dark:bg-amber-500/20 text-sap-terracotta dark:text-amber-300 font-bold text-sm">
                3
              </div>
              <div>
                <h4 class="font-serif text-base font-bold text-sap-navy dark:text-white">Elders, Mentors & Active Citizens</h4>
                <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">Bring generational wisdom, civilisational memory, and guidance to nurture future civic leaders.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quote & Eligibility Callout -->
        <div class="lg:col-span-6">
          <div class="rounded-3xl bg-sap-sand dark:bg-[#0e223d] p-8 sm:p-12 border border-stone-200 dark:border-slate-700/80 shadow-md space-y-6">
            <div class="font-cinzel text-xs font-bold uppercase tracking-widest text-sap-terracotta dark:text-amber-400">
              The Only Prerequisite
            </div>
            <blockquote class="font-serif text-xl sm:text-2xl font-semibold text-sap-navy dark:text-amber-100 leading-relaxed">
              "No prior political background is required. We look for integrity, empathy, and the genuine hunger to serve society rather than rule it."
            </blockquote>

            <div class="border-t border-stone-300 dark:border-slate-700 pt-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Admissions Format</div>
                <div class="text-sm font-bold text-sap-navy dark:text-white">Rolling Cohorts & Fellowships</div>
              </div>

              <button
                type="button"
                class="trigger-apply-modal inline-flex items-center justify-center rounded-lg bg-sap-navy dark:bg-sap-terracotta px-6 py-3 text-xs font-semibold uppercase tracking-wider text-white hover:bg-sap-terracotta dark:hover:bg-sap-terracottaDark transition shadow"
              >
                Start Your Application
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Homepage Direct Application Section -->
  <section class="py-20 bg-sap-navy text-white relative overflow-hidden">
    <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-2xl mx-auto text-center space-y-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-amber-300 bg-white/10 px-3.5 py-1 rounded-full">
          Take The First Step
        </span>
        <h2 class="font-serif text-3xl font-bold sm:text-4xl text-white">
          Join the School of Awakened Politics
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Submit your application to participate in our upcoming fellowship cohorts, retreat circles, or governance circuits.
        </p>

        <!-- Quick Form -->
        <div class="mt-8 rounded-2xl bg-white/10 backdrop-blur-md p-6 sm:p-8 border border-white/20 text-left">
          <form id="home-quick-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-200">Full Name *</label>
                <input 
                  type="text" 
                  name="fullName"
                  required 
                  placeholder="Your full name"
                  class="mt-1 w-full rounded-lg border border-slate-600 bg-white/10 px-4 py-2.5 text-sm text-white placeholder-slate-400 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-200">Email ID *</label>
                <input 
                  type="email" 
                  name="email"
                  required 
                  placeholder="name@example.com"
                  class="mt-1 w-full rounded-lg border border-slate-600 bg-white/10 px-4 py-2.5 text-sm text-white placeholder-slate-400 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-200">Program Interest</label>
              <select name="program" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-900 px-4 py-2.5 text-sm text-white focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400">
                <option value="SAP World Leaders Fellowship Program">SAP World Leaders Fellowship Program</option>
                <option value="Governance Circuits (Field Journeys)">Governance Circuits (Field Journeys)</option>
                <option value="Conscious Parliament Circles">Conscious Parliament Circles</option>
                <option value="Leadership Retreats">Leadership Retreats</option>
              </select>
            </div>

            <div id="home-form-feedback" class="hidden rounded-xl p-3 text-xs font-medium space-y-1"></div>

            <button 
              type="submit" 
              id="home-submit-btn"
              class="w-full rounded-lg bg-sap-terracotta py-3 text-sm font-semibold uppercase tracking-wider text-white shadow-lg hover:bg-sap-terracottaDark transition"
            >
              Submit Application
            </button>
          </form>
          <p class="mt-3 text-center text-xs text-slate-400">
            Official Contact: <a href="mailto:info@schoolofawakenedpolitics.org" class="text-amber-300 underline">info@schoolofawakenedpolitics.org</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    function setupHomeQuickForm() {
      const form = document.getElementById('home-quick-form') as HTMLFormElement | null;
      const feedback = document.getElementById('home-form-feedback');
      const submitBtn = document.getElementById('home-submit-btn');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) submitBtn.textContent = 'Submitting...';

        const formData = new FormData(form);
        const refId = `SAP-2026-${Date.now().toString(36).toUpperCase()}`;
        const record = {
          id: refId,
          timestamp: new Date().toISOString(),
          fullName: String(formData.get('fullName') || ''),
          email: String(formData.get('email') || ''),
          phone: '',
          program: String(formData.get('program') || ''),
          statement: 'Submitted via Homepage Quick Form'
        };

        // 1. Save locally
        try {
          const list = JSON.parse(localStorage.getItem('sap_applications') || '[]');
          list.unshift(record);
          localStorage.setItem('sap_applications', JSON.stringify(list));
        } catch (err) {}

        // 2. Email dispatch
        const emailPromise = fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            access_key: '5b1dc854-c8c8-4ce6-a797-ea6541f92e7b',
            subject: `New SAP Application [${refId}]: ${record.fullName}`,
            from_name: 'SAP Admissions Portal',
            replyto: record.email,
            ...record
          })
        }).catch(() => {});

        // 3. Webhook dispatch
        const sheetUrl = localStorage.getItem('sap_sheets_webhook_url');
        let sheetPromise: Promise<any> | null = null;
        if (sheetUrl && sheetUrl.startsWith('http')) {
          sheetPromise = fetch(sheetUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(record)
          }).catch(() => {});
        }

        await Promise.allSettled([emailPromise, sheetPromise].filter(Boolean));

        if (feedback) {
          feedback.classList.remove('hidden');
          feedback.className = 'rounded-xl p-3.5 text-xs font-medium bg-emerald-950/60 text-emerald-200 border border-emerald-500/60 space-y-1';
          feedback.innerHTML = `
            <div class="font-bold text-amber-300">✓ Application Received! (Ref: ${refId})</div>
            <div>Sent to admissions (info@schoolofawakenedpolitics.org) & recorded in admissions registry. We will contact you soon.</div>
          `;
        }
        form.reset();
        if (submitBtn) submitBtn.textContent = 'Application Registered ✓';
      });
    }

    document.addEventListener('DOMContentLoaded', setupHomeQuickForm);
  </script>
</BaseLayout>
